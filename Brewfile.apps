cask "mmex"

# Communication
cask "discord"
cask "element"
cask "telegram-desktop"
cask "whatsapp"
cask "microsoft-teams"

# Menu bar and system utilities
cask "hiddenbar"
cask "meetingbar"
cask "stats"
cask "monitorcontrol"
cask "rectangle-pro"
cask "appcleaner"
cask "latest"
cask "glinford/tap/dns-easy-switcher", trusted: true
cask "localsend"
cask "logi-options+"
cask "radio-silence"
cask "reikey"
cask "yubico-authenticator"
cask "protonvpn"
cask "teamviewer"
cask "balenaetcher"

# Media and games
cask "spotify"
cask "vlc"
cask "obs"
cask "jellyfin-media-player"
cask "transmission"
cask "steam"
cask "minecraft"

