# GUI apps and App Store apps. Installed by `./setup-mac.sh apps`.
# Sign in to the App Store first, or the mas entries fail.
# Apps already in /Applications that Homebrew did not install are skipped by
# setup-mac.sh, so this is safe to run on a Mac that already has them.
# Install by hand (no usable cask): Bartender 6 (the cask is Bartender 7),
# FileZilla, VMware Fusion and YubiKey Manager.

tap "glinford/tap"
tap "johannesnagl/tap"

# Development
cask "docker-desktop"
cask "zed"
cask "android-studio"
cask "bruno"
cask "beekeeper-studio"
cask "mongodb-compass"
cask "redis-insight"
cask "charles"
cask "cyberduck"
cask "chromium"
cask "johannesnagl/tap/showmd", trusted: true
cask "markdown-preview"

# AI and agents
cask "conductor"
cask "claude"
cask "lm-studio"
cask "ollama-app"
cask "emdash"
cask "open-design"
cask "block-buzz"
cask "typewhisper"

# Browsers
cask "brave-browser"
cask "google-chrome"
cask "firefox"
cask "librewolf"
cask "zen"

# Productivity
cask "1password"
cask "raycast"
cask "linear"
cask "obsidian"
cask "ticktick"
cask "granola"
cask "mailspring"
cask "libreoffice"
cask "affinity"
