// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
// Machine-specific blocks (agent_servers, ssh_connections) live only in the local copy.
{
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "proxy": "",
  "ui_font_family": ".ZedSans",
  "ui_font_weight": 400,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 300,
  "buffer_font_family": ".ZedMono",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "enable_feedback": false,
    "sidebar_side": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "vim_mode": false,
  "ui_font_size": 15,
  "buffer_font_size": 12,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark"
  }
}
