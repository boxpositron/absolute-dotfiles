{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome-tmux"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 0.63
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents-tmux"
              },
              "size": {
                "weight": 1.24
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome-tmux",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 424
      },
      "min": 44,
      "max": 480,
      "background": {
        "gradient": [
          "#160b30",
          "#07060f"
        ],
        "angle": 180
      },
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-tmux"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 3,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "gap": 8,
              "resizable": false,
              "children": [
                {
                  "id": "panel-context",
                  "type": "block",
                  "content": {
                    "mod": "tmux-context"
                  },
                  "size": {
                    "px": 116
                  }
                },
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files-tree",
                          "type": "block",
                          "content": {
                            "mod": "files-tmux"
                          }
                        },
                        {
                          "id": "files-preview",
                          "type": "block",
                          "content": {
                            "mod": "preview",
                            "props": {
                              "panel": "files"
                            }
                          },
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "radius": 10
                        },
                        {
                          "id": "files-edit",
                          "type": "block",
                          "content": {
                            "terminal": "files-nvim"
                          },
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "radius": 10,
                          "padding": 6
                        }
                      ],
                      "active": "files-tree"
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes-tmux"
                      }
                    },
                    {
                      "id": "mcp",
                      "type": "block",
                      "content": {
                        "mod": "mcp-tmux"
                      }
                    },
                    {
                      "id": "omo",
                      "type": "block",
                      "content": {
                        "mod": "omo-tmux"
                      }
                    },
                    {
                      "id": "jobs",
                      "type": "block",
                      "content": {
                        "mod": "jobs-tmux"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 712
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status-tmux"
              }
            },
            {
              "id": "data-tmux-context",
              "type": "block",
              "size": {
                "px": 0
              },
              "content": {
                "mod": "tmux-context",
                "props": {
                  "headless": true
                }
              }
            },
            {
              "id": "data-omo-tmux",
              "type": "block",
              "size": {
                "px": 0
              },
              "content": {
                "mod": "omo-tmux",
                "props": {
                  "headless": true
                }
              }
            },
            {
              "id": "data-mcp-tmux",
              "type": "block",
              "size": {
                "px": 0
              },
              "content": {
                "mod": "mcp-tmux",
                "props": {
                  "headless": true
                }
              }
            },
            {
              "id": "data-jobs-tmux",
              "type": "block",
              "size": {
                "px": 0
              },
              "content": {
                "mod": "jobs-tmux",
                "props": {
                  "headless": true
                }
              }
            }
          ]
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "gradient": [
      "#140a2a",
      "#05050b"
    ],
    "angle": 160
  },
  "theme": "netrunner",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "#00f0ff40"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
