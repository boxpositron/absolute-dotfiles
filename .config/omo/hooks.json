{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/omo-notify", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/omo-notify", "timeout": 10 },
          { "type": "command", "command": "~/.local/bin/owt hook", "timeout": 5 },
          { "type": "command", "command": "~/.local/bin/omo-work hook", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/omo-notify", "timeout": 10 },
          { "type": "command", "command": "~/.local/bin/omo-work hook", "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/omo-notify", "timeout": 10 },
          { "type": "command", "command": "~/.local/bin/omo-work hook", "timeout": 5 }
        ]
      }
    ]
  }
}
