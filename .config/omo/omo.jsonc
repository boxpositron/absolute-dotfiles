// OMO routing for the native agent, using Claude, OpenAI and z.ai models.
{
  // Shared metadata.
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "_migrations": [
    "2026-07-codex-config-jsonc",
    "2026-08-reasoning-unification",
    "2026-07-opencode-config-unification"
  ],

  // Native agent and category routing.
  "[native]": {
    // Claude leads implementation; GPT independently reviews technical work.
    "model_profile": "hybrid",
    "model_profiles": {
      "hybrid": {
        "display_name": "Claude implementation / GPT review",
        "models": [
          {
            "model": "anthropic-subscription/claude-opus-5-5",
            "reasoning": "xhigh"
          },
          {
            "model": "chatgpt-subscription/gpt-6.1-sol",
            "reasoning": "high"
          }
        ]
      }
    },
    "categories": {
      "architect": {
        "models": [
          {
            "model": "anthropic-subscription/claude-fable-5-1",
            "reasoning": "xhigh"
          },
          {
            "model": "chatgpt-subscription/gpt-6-astra",
            "reasoning": "high"
          }
        ]
      },
      "artistry": {
        "models": [
          {
            "model": "anthropic-subscription/claude-opus-5-5",
            "reasoning": "high"
          },
          {
            "model": "zai/glm-5.3",
            "reasoning": "high"
          }
        ]
      },
      "deep-low": {
        "models": [
          {
            "model": "anthropic-subscription/claude-sonnet-5-5",
            "reasoning": "high"
          },
          {
            "model": "chatgpt-subscription/gpt-6.1-sol",
            "reasoning": "high"
          },
          {
            "model": "zai/glm-5.3",
            "reasoning": "high"
          }
        ]
      },
      "deep-high": {
        "model": "chatgpt-subscription/gpt-6-astra",
        "reasoning": "high"
      },
      "quick": {
        "models": [
          {
            "model": "zai/glm-5.3-flash",
            "reasoning": "low"
          },
          {
            "model": "anthropic-subscription/claude-sonnet-5-5",
            "reasoning": "low"
          }
        ]
      },
      "ultrabrain": {
        "model": "chatgpt-subscription/gpt-6-astra",
        "reasoning": "max"
      },
      "unspecified-high": {
        "model": "chatgpt-subscription/gpt-6-astra",
        "reasoning": "high"
      },
      "unspecified-low": {
        "models": [
          {
            "model": "anthropic-subscription/claude-sonnet-5-5",
            "reasoning": "medium"
          },
          {
            "model": "zai/glm-5.3",
            "reasoning": "high"
          }
        ]
      },
      "visual-engineering": {
        "model": "chatgpt-subscription/gpt-6-astra",
        "reasoning": "high",
        "prompt_append": "Before substantive UI work, load frontend-workflow. Follow the product's design context, keep one writer per file set, inspect actual desktop and mobile screenshots, exercise the primary interaction, and report verification evidence. Stop when acceptance criteria pass."
      },
      "writing": {
        "models": [
          {
            "model": "anthropic-subscription/claude-sonnet-5-5",
            "reasoning": "medium"
          },
          {
            "model": "zai/glm-5.3",
            "reasoning": "high"
          }
        ]
      }
    },
    "agents": {
      "explore": {
        "models": [
          {
            "model": "zai/glm-5.3-flash",
            "reasoning": "low"
          },
          {
            "model": "anthropic-subscription/claude-sonnet-5-5",
            "reasoning": "low"
          }
        ]
      },
      "librarian": {
        "models": [
          {
            "model": "zai/glm-5.3-flash",
            "reasoning": "low"
          },
          {
            "model": "anthropic-subscription/claude-sonnet-5-5",
            "reasoning": "low"
          }
        ]
      },
      "plan-consultant": {
        "models": [
          {
            "model": "anthropic-subscription/claude-fable-5-1",
            "reasoning": "xhigh"
          },
          {
            "model": "zai/glm-5.3",
            "reasoning": "high"
          }
        ]
      },
      "plan-reviewer": {
        "models": [
          {
            "model": "chatgpt-subscription/gpt-6-astra",
            "reasoning": "high"
          },
          {
            "model": "chatgpt-subscription/gpt-6.1-sol",
            "reasoning": "high"
          }
        ]
      }
    }
  }
}
