#!/usr/bin/env bash
# omo-sessions: the library of omo sessions closed on purpose, reopening them or starting
# fresh from their handoff, and handing a task from one session to another. It also brings
# back the sessions a logout, reboot or crash ended, with their tmux panes (`resurrect`).
#
# agent-state's collector reads library.json and handoffs.jsonl from this machine's state
# folder. vim-quit.ts (the omo extension) calls `file`, `unfile` and `taken`, and acts on
# the requests written here. A handoff to another machine is recorded here, reaches that
# machine through agent-state and is delivered by its collector with `deliver`.
set -u
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$HOME/.bun/bin:$PATH"

# Run outside tmux with no UTF-8 locale, tmux prints control characters as "_".
tmux() { command tmux -u "$@"; }

state=${OMO_SESSIONS_DIR:-$HOME/.local/state/omo-sessions}
library=$state/library.json
handoffs=$state/handoffs.jsonl
requests=$state/requests
transcripts=${OMO_AGENT_DIR:-$HOME/.omo/agent}/sessions
# The sessions running in tmux panes, so `resurrect` can reopen the ones a logout, reboot or crash ended: one
# running/<session id>.json each, written by the omo extension omo-resurrect.ts when a session starts and removed
# when it is closed on purpose. {sid, pid, cwd, sessionFile, name, pane, socket and server (the tmux server's socket
# and pid), target (session:window.pane, as tmux-resurrect saves it), window, tmuxSession, startedAt, and endedBy and
# endedAt once a signal ended it; adopted: true when `snapshot` made it}
running=$state/running

die() {
  printf 'omo-sessions: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
omo-sessions: closed sessions, and work passed between sessions

  list                         The library, newest first
  park <session> | --all       File a session and close it (--all: every idle or finished pane)
  resume <session> | --all     Reopen a parked session; it leaves the library when it starts
  fresh <session>              Start a new session from a parked or live session's handoff
  open <machine> <session> [--fresh]
                               Reopen (or start fresh) on a machine and show it in Herdr
  handoff [--on <machine>] [--cwd <dir>] <session|new> <task...>
                               Give a task to a running session, or to a new one
  start [--tmux <session>] [--cwd <dir>] <task...>
                               Start omo on a task in a new window of a tmux session (made if
                               missing), named after a random city; prints the pane
  title <words>                Retitle a started task's window: one to three words naming the work
  resurrect [--dry-run]        Reopen the sessions that ended with an earlier tmux server (a logout,
                               reboot or crash), in their restored panes; tmux-resurrect runs it
  snapshot                     Note where each running session's pane is; each tmux-resurrect save runs it
  boot                         Start tmux, which restores the last save; the login agent runs it
  install                      Install that launchd agent, on a Mac

A session is an id, an id prefix or a tmux target. Machines are agent-state's names, such as mac.
Called by other tools: file, unfile, taken, deliver, snapshot.
EOF
}

# The machine's name in agent-state: $OMO_MACHINE, else the first line of $state/machine (a server
# whose hostname isn't its agent-state name keeps it there), else mac on macOS or the short hostname.
self_machine() {
  if [[ -n ${OMO_MACHINE:-} ]]; then
    printf '%s\n' "$OMO_MACHINE"
  elif [[ -s $state/machine ]]; then
    head -n 1 "$state/machine"
  elif [[ $(uname) == Darwin ]]; then
    echo mac
  else
    hostname -s
  fi
}

now_ms() { echo "$(($(date +%s) * 1000))"; }

lock() {
  local tries=0
  mkdir -p "$state"
  until mkdir "$state/.lock" 2>/dev/null; do
    # Nothing holds the lock this long: a killed run left it.
    [[ -n $(find "$state/.lock" -maxdepth 0 -mmin +1 2>/dev/null) ]] && rmdir "$state/.lock" 2>/dev/null
    tries=$((tries + 1))
    ((tries > 100)) && die "the library is locked ($state/.lock)"
    sleep 0.1
  done
  trap 'rmdir "$state/.lock" 2>/dev/null' EXIT
}

unlock() {
  rmdir "$state/.lock" 2>/dev/null
  trap - EXIT
}

# Applies a jq program to the library. A library jq can't read is left as it is.
update_library() {
  local tmp="$library.$$"
  if [[ -f $library ]]; then
    jq "$@" "$library" >"$tmp" || {
      rm -f "$tmp"
      die "couldn't update $library"
    }
  else
    jq -n '{version: 1, sessions: []}' | jq "$@" >"$tmp"
  fi
  mv "$tmp" "$library"
}

append_handoff() {
  lock
  printf '%s\n' "$1" >>"$handoffs"
  unlock
}

# The transcript of a session id, id prefix or tmux target.
session_file() {
  local spec=$1 matches
  if [[ $spec == *:* || $spec == %* ]]; then
    spec=$(tmux display-message -p -t "$spec" '#{@omo_transcript}' 2>/dev/null)
    [[ -r $spec ]] || return 1
    printf '%s\n' "$spec"
    return
  fi
  matches=("$transcripts"/*/*_"$spec"*.jsonl)
  [[ ${#matches[@]} -eq 1 && -r ${matches[0]} ]] || return 1
  printf '%s\n' "${matches[0]}"
}

sid_of() {
  local name=${1##*_}
  printf '%s\n' "${name%.jsonl}"
}

session_name() { grep '"type":"session_info"' "$1" | tail -n 1 | jq -r '.name // empty' 2>/dev/null; }
session_cwd() { head -n 1 "$1" | jq -r '.cwd // empty' 2>/dev/null; }

# The session's latest handoff block, from its "Ask:" line on.
handoff_text() {
  grep '"role":"assistant"' "$1" | grep -E '(\\n|")Ask:' | tail -n 1 |
    jq -r '.message.content | if type == "array" then map(select(.type == "text") | .text) | join("\n") else . end' 2>/dev/null |
    sed -n '/^Ask:/,$p'
}

pane_of() {
  tmux list-panes -a -F '#{pane_id} #{@omo_transcript}' 2>/dev/null |
    awk -v tail="_$1.jsonl" 'index($0, tail) { print $1; exit }'
}

# The pid of the omo process holding session <sid> open. A holder left by a session a logout ended can name a pid
# another program has since, so the process must be omo's.
holder_pid() {
  local holder pid
  for holder in "$transcripts"/*/session-holders/"$1"/*.json; do
    [[ -r $holder ]] || continue
    pid=$(jq -r '.pid // empty' "$holder" 2>/dev/null)
    [[ -n $pid ]] || continue
    case $(ps -o command= -p "$pid" 2>/dev/null) in
      */senpi/dist/* | */omo | */omo\ *) printf '%s\n' "$pid" && return 0 ;;
    esac
  done
  return 1
}

is_live() { holder_pid "$1" >/dev/null; }

library_entry() {
  [[ -f $library ]] && jq -c --arg sid "$1" '.sessions[] | select(.sid == $sid)' "$library"
}

write_request() {
  mkdir -p "$requests"
  printf '%s\n' "$2" >"$requests/.$1.tmp" && mv "$requests/.$1.tmp" "$requests/$1.json"
}

# What a pane runs for omo with these arguments: the login shell starts omo and stays when it exits.
omo_command() {
  local command=omo arg
  for arg in "$@"; do command+=" $(printf '%q' "$arg")"; done
  printf '%s\n' "$command; exec ${SHELL:-/bin/sh} -l"
}

# A new tmux window running omo, left in the background. Prints its pane.
launch() {
  local cwd=$1 session=$2 window=$3 id=$4 shell=${SHELL:-/bin/sh} command
  shift 4
  command=$(omo_command "$@")
  [[ -n $session ]] || session=$(basename "$cwd" | tr '.:' '--')
  window=${window:0:30}
  if tmux has-session -t "=$session" 2>/dev/null; then
    tmux new-window -d -P -F '#{pane_id}' -t "=$session:" -c "$cwd" -n "$window" ${id:+-e "OMO_HANDOFF_ID=$id"} -- "$shell" -lic "$command"
  else
    tmux new-session -d -P -F '#{pane_id}' -s "$session" -c "$cwd" -n "$window" ${id:+-e "OMO_HANDOFF_ID=$id"} -- "$shell" -lic "$command"
  fi
}

cmd_file() {
  local sid=${1:?session id required} reason=sq cwd="" file="" pane place="" tmux_session="" name entry
  shift
  while (($#)); do
    case $1 in
      --reason) reason=$2 ;;
      --cwd) cwd=$2 ;;
      --session-file) file=$2 ;;
      *) die "unknown option $1" ;;
    esac
    shift 2
  done
  [[ -n $file ]] || file=$(session_file "$sid") || die "no transcript for $sid"
  [[ -n $cwd ]] || cwd=$(session_cwd "$file")
  name=$(session_name "$file")
  pane=$(pane_of "$sid")
  pane=${pane:-${TMUX_PANE:-}}
  if [[ -n $pane ]]; then
    place=$(tmux display-message -p -t "$pane" '#{session_name}:#{window_index}' 2>/dev/null)
    tmux_session=${place%:*}
  fi
  entry=$(jq -cn --arg sid "$sid" --argjson at "$(now_ms)" --arg reason "$reason" --arg cwd "$cwd" --arg name "$name" \
    --arg tmux "$place" --arg session "$tmux_session" --arg file "$file" --arg resume "cd $(printf '%q' "$cwd") && omo --session $sid" \
    '{sid: $sid, parkedAt: $at, reason: $reason, cwd: $cwd, name: $name, tmux: $tmux, tmuxSession: $session, sessionFile: $file, resume: $resume}
     | with_entries(select(.value != ""))')
  lock
  update_library --argjson entry "$entry" '.sessions = ([.sessions[] | select(.sid != $entry.sid)] + [$entry])'
  unlock
}

cmd_unfile() {
  local sid=${1:?session id required}
  # Every session starting calls this, and nearly all of them aren't in the library.
  [[ -f $library ]] && grep -Fq "\"$sid\"" "$library" || return 0
  lock
  update_library --arg sid "$sid" '.sessions |= map(select(.sid != $sid))'
  unlock
}

cmd_taken() {
  local id=${1:?handoff id required} sid=${2:?session id required} latest
  latest=$(grep -F "\"id\":\"$id\"" "$handoffs" 2>/dev/null | tail -n 1)
  [[ -n $latest ]] || die "no handoff $id on this machine"
  append_handoff "$(jq -c --arg machine "$(self_machine)" --arg sid "$sid" --argjson now "$(now_ms)" \
    '.status = "taken" | .takenBy = {machine: $machine, sid: $sid} | .updatedAt = $now' <<<"$latest")"
}

cmd_list() {
  [[ -f $library ]] || return 0
  jq -r '.sessions | sort_by(-.parkedAt)[] | [.sid[0:8], .reason, (.parkedAt / 1000 | strftime("%F %H:%M")), (.tmux // "-"), (.name // .cwd // "")] | @tsv' "$library"
}

cmd_park() {
  # The panes parked are not this one, so this pane says nothing about where they ran.
  unset TMUX_PANE
  if [[ ${1:-} == --all ]]; then
    local line
    tmux list-panes -a -f '#{?#{m:*~[0-9]*,#{session_name}},0,1}' -F '#{@omo_state} #{@omo_transcript}' | awk '($1 == "idle" || $1 == "done" || $1 == "partial") && NF == 2 { print $2 }' |
      while read -r line; do cmd_park "$(sid_of "$line")"; done
    return
  fi
  local file sid
  file=$(session_file "${1:?session required}") || die "no session matches $1"
  sid=$(sid_of "$file")
  cmd_file "$sid" --reason park --session-file "$file"
  write_request "$sid" '{"action":"quit"}'
  echo "parked $sid"
}

cmd_resume() {
  if [[ ${1:-} == --all ]]; then
    [[ -f $library ]] || return 0
    local each
    jq -r '.sessions[].sid' "$library" | while read -r each; do cmd_resume "$each"; done
    return
  fi
  local file sid entry cwd
  file=$(session_file "${1:?session required}") || die "no session matches $1"
  sid=$(sid_of "$file")
  if is_live "$sid"; then
    pane_of "$sid"
    return
  fi
  # A request it never picked up would act on the reopened session.
  rm -f "$requests/$sid.json"
  entry=$(library_entry "$sid")
  cwd=$(jq -r '.cwd // empty' <<<"$entry")
  [[ -n $cwd ]] || cwd=$(session_cwd "$file")
  [[ -d $cwd ]] || cwd=$HOME
  launch "$cwd" "$(jq -r '.tmuxSession // empty' <<<"$entry")" "$(session_name "$file")" "" --session "$sid"
}

new_id() { printf 'h%x%04x\n' "$(date +%s)" "$RANDOM"; }

cmd_fresh() {
  local file sid name cwd text id machine prompt entry
  file=$(session_file "${1:?session required}") || die "no session matches $1"
  sid=$(sid_of "$file")
  name=$(session_name "$file")
  cwd=$(session_cwd "$file")
  [[ -d $cwd ]] || cwd=$HOME
  text=$(handoff_text "$file")
  entry=$(library_entry "$sid")
  id=$(new_id)
  machine=$(self_machine)
  prompt="Continue the work of an earlier omo session (${name:-unnamed}, $sid). Its full transcript is at $file: read it when you need more detail than this. That session stays as it is."
  if [[ -n $text ]]; then prompt+=$'\n\nIts latest handoff:\n\n'"$text"; else prompt+=$'\n\nIt left no handoff, so start from the end of the transcript.'; fi
  append_handoff "$(jq -cn --arg id "$id" --argjson now "$(now_ms)" --arg machine "$machine" --arg sid "$sid" --arg name "$name" --arg cwd "$cwd" \
    '{id: $id, at: $now, updatedAt: $now, from: {machine: $machine, sid: $sid, name: $name}, to: {machine: $machine, cwd: $cwd, mode: "fresh"}, task: ("Start fresh from " + (if $name == "" then $sid else $name end)), status: "delivered"}')"
  launch "$cwd" "$(jq -r '.tmuxSession // empty' <<<"$entry")" "fresh ${name:-omo}" "$id" --name "${name:-omo} (fresh)" -- "$prompt"
}

# Carries out a handoff on the machine it is for. Safe to repeat: agent-state hands the
# same record back until this machine's own update reaches it.
cmd_deliver() {
  local record=${1:?handoff record required} id mode spec task from file sid cwd status=delivered detail=""
  id=$(jq -r '.id' <<<"$record") || die "not a handoff record"
  if [[ -f $handoffs ]] && grep -F "\"id\":\"$id\"" "$handoffs" | grep -Eq '"status":"(delivered|taken|failed)"'; then return 0; fi
  mode=$(jq -r '.to.mode' <<<"$record")
  spec=$(jq -r '.to.sid // empty' <<<"$record")
  task=$(jq -r '.task' <<<"$record")
  from=$(jq -r '(.from.name // .from.sid // "another session") + " on " + (.from.machine // "another machine")' <<<"$record")
  if [[ $mode == session ]]; then
    if file=$(session_file "$spec"); then
      sid=$(sid_of "$file")
      write_request "$sid" "$(jq -cn --arg text "$task" --arg id "$id" --arg from "$from" '{action: "message", text: $text, handoff: $id, from: $from}')"
      record=$(jq -c --arg sid "$sid" '.to.sid = $sid' <<<"$record")
    else
      status=failed detail="no session matches $spec on $(self_machine)"
    fi
  else
    cwd=$(jq -r '.to.cwd // empty' <<<"$record")
    cwd=${cwd:-$HOME}
    if [[ ! -d $cwd ]]; then
      status=failed detail="no folder $cwd on $(self_machine)"
    elif ! launch "$cwd" "" handoff "$id" -- "[Handoff $id from $from] $task" >/dev/null; then
      status=failed detail="couldn't open a tmux window on $(self_machine)"
    fi
  fi
  append_handoff "$(jq -c --arg status "$status" --arg detail "$detail" --argjson now "$(now_ms)" \
    '.status = $status | .updatedAt = $now | if $detail == "" then . else .detail = $detail end' <<<"$record")"
  [[ $status == delivered ]] || die "$detail"
}

cmd_handoff() {
  local on="" cwd="" target="" task machine id from_file="" from_sid="" from_name="" to
  # Options may come before or after the target; everything after them is the task.
  while (($#)); do
    case $1 in
      --on) on=$2; shift 2 ;;
      --cwd) cwd=$2; shift 2 ;;
      *)
        [[ -z $target ]] || break
        target=$1
        shift
        ;;
    esac
  done
  [[ -n $target ]] || die "who takes it? a session or new"
  task="$*"
  [[ -n $task ]] || die "no task given"
  machine=$(self_machine)
  on=${on:-$machine}
  id=$(new_id)
  if [[ -n ${TMUX_PANE:-} ]]; then from_file=$(tmux display-message -p -t "$TMUX_PANE" '#{@omo_transcript}' 2>/dev/null); fi
  if [[ -r $from_file ]]; then
    from_sid=$(sid_of "$from_file")
    from_name=$(session_name "$from_file")
  fi
  if [[ $target == new ]]; then
    [[ -n $cwd || $on != "$machine" ]] || cwd=$PWD
    to=$(jq -cn --arg machine "$on" --arg cwd "$cwd" '{machine: $machine, mode: "new"} + (if $cwd == "" then {} else {cwd: $cwd} end)')
  else
    to=$(jq -cn --arg machine "$on" --arg sid "$target" '{machine: $machine, sid: $sid, mode: "session"}')
  fi
  local record
  record=$(jq -cn --arg id "$id" --argjson now "$(now_ms)" --arg machine "$machine" --arg sid "$from_sid" --arg name "$from_name" --argjson to "$to" --arg task "$task" \
    '{id: $id, at: $now, updatedAt: $now, from: ({machine: $machine, sid: $sid, name: $name} | with_entries(select(.value != ""))), to: $to, task: $task, status: "sent"}')
  append_handoff "$record"
  if [[ $on == "$machine" ]]; then
    cmd_deliver "$record" || exit 1
    echo "handed off as $id"
  else
    echo "handed off as $id; $on's collector delivers it within a minute"
  fi
}

# A new omo session on a task, in a new window of the tmux session named (in that session's folder, or --cwd), or of
# the session named after --cwd's folder; a missing session is made in --cwd or the home folder. Herdr's picker uses it.
cmd_start() {
  local session="" cwd="" task words
  while (($#)); do
    case $1 in
      --tmux) session=$2; shift 2 ;;
      --cwd) cwd=$2; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  task="$*"
  [[ -n $task ]] || die "no task given"
  if [[ -z $cwd && -n $session ]] && tmux has-session -t "=$session" 2>/dev/null; then
    cwd=$(tmux display-message -p -t "=$session:" '#{session_path}')
  fi
  cwd=${cwd:-$HOME}
  [[ -d $cwd ]] || die "no folder $cwd on $(self_machine)"
  # The window is named after a random city, as owt names workspaces, until the session titles it.
  local city pane
  read -r -a words <<<"$task"
  city=$("$HOME/.local/bin/owt" city 2>/dev/null) || city=${words[*]:0:4}
  pane=$(launch "$cwd" "$session" "$city" "" -- "$task") || exit 1
  tmux set-option -p -t "$pane" @omo_task 1
  printf '%s\n' "$pane"
}

# A started task's session names its window after the work (the hook below reminds it).
cmd_title() {
  local words=() title
  [[ -n ${TMUX_PANE:-} ]] || die "not in a tmux pane"
  read -ra words <<<"$(printf '%s ' "$@" | tr -s '[:space:]' ' ' | tr -d '[:cntrl:]')"
  ((${#words[@]} >= 1 && ${#words[@]} <= 3)) || die "a title is one to three words naming the work, e.g. omo-sessions title remotion setup"
  title="${words[*]}"
  tmux rename-window -t "$TMUX_PANE" "$title" \; set-option -p -t "$TMUX_PANE" @omo_task_title "$title"
  echo "titled this window '$title'"
}

# omo UserPromptSubmit hook: in a window `start` opened, hands the agent the window's title with each prompt, so
# it names the work once it knows it and keeps the name current. owt's hook does the same in workspaces.
cmd_hook() {
  local title context
  [[ -t 0 ]] || cat >/dev/null
  [[ -n ${TMUX_PANE:-} && $(tmux show-options -pqv -t "$TMUX_PANE" @omo_task 2>/dev/null) == 1 ]] || return 0
  title=$(tmux display-message -p -t "$TMUX_PANE" '#{window_name}')
  if [[ -n $(tmux show-options -pqv -t "$TMUX_PANE" @omo_task_title 2>/dev/null) ]]; then
    context="This task's tmux window is titled \\\"$title\\\". If the work changes, retitle it with \`omo-sessions title <words>\`: one to three short words naming the work, never a sentence."
  else
    context="This task's tmux window still has its placeholder name, the city \\\"$title\\\". As soon as you know what the work is, title it with \`omo-sessions title <words>\`: one to three short words naming the work, never a sentence (for example \`omo-sessions title remotion setup\`). Retitle it whenever the focus shifts."
  fi
  printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}\n' "$context"
}

# Shows the session in Herdr: only where the Herdr app runs, which is what clicks a board card.
cmd_open() {
  local machine=${1:?machine required} sid=${2:?session required} action=resume remote="" pane
  [[ ${3:-} == --fresh ]] && action=fresh
  if [[ $machine == "$(self_machine)" ]]; then
    pane=$("$0" "$action" "$sid") || exit 1
  else
    remote=$(hc machine ls --json | jq -r --arg m "$machine" 'first(.machines[] | select(.state == "connected" and (.name == $m or (.name | startswith($m + "-")))) | .name) // empty')
    [[ -n $remote ]] || die "$machine isn't connected"
    pane=$(hc exec --on "$remote" --timeout 25 sh -c 'exec "$HOME/.local/bin/omo-sessions" "$@"' omo-sessions "$action" "$sid") || exit 1
  fi
  [[ -n $pane ]] || die "no pane for $sid"
  "$HOME/.local/bin/omo-status" show "${remote:+$remote/}$pane" || exit 1
  # `show` goes to the pane in its session that most needs you, and this is the one asked for.
  if [[ -n $remote ]]; then
    hc exec --on "$remote" --timeout 5 sh -c 'tmux select-window -t "$1" \; select-pane -t "$1"' omo-sessions "$pane"
  else
    tmux select-window -t "$pane" \; select-pane -t "$pane"
  fi
}

# A lock for a job that runs alone: fails while another run holds it. One a killed run left lapses after $2 minutes.
try_lock() {
  mkdir "$1" 2>/dev/null && return 0
  [[ -n $(find "$1" -maxdepth 0 -mmin "+$2" 2>/dev/null) ]] && rmdir "$1" 2>/dev/null && mkdir "$1" 2>/dev/null
}

note() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }

# A running record's fields, joined by \x1f (a field may be empty, which tab-separated reads would skip).
record_fields() {
  jq -r '[.sid, .pid, .socket, .server, .pane, .cwd, .sessionFile, .target, .tmuxSession, .window, .name]
    | map(. // "" | tostring) | join("\u001f")' "$1" 2>/dev/null
}

# tmux-resurrect's post-save hook (each save, so every 15 minutes with tmux-continuum) brings the running records in
# line with the tmux it saved. A live session's record takes its pane's place now, as windows move and get renamed. A
# session that ended while this tmux server kept running loses its record: it didn't end with tmux (it was closed in
# tmux, or it crashed). An omo pane with no record, a session started before omo-resurrect.ts was loaded, gets one.
# Then `omo-status herdr-save` notes which tmux session each Herdr tab shows, for `omo-status reattach`.
cmd_snapshot() {
  local server socket panes file sid pid rsocket rserver pane place target tsession window transcript new
  server=$(tmux display-message -p '#{pid}' 2>/dev/null) || return 0
  socket=$(tmux display-message -p '#{socket_path}')
  mkdir -p "$running"
  # tmux-continuum can start two saves at once.
  try_lock "$running/.snapshot" 2 || return 0
  # Not the sessions of tab mode's Herdr tabs ("<session>~<window>"): they list each pane again, under a session
  # tmux-resurrect doesn't bring back as such.
  panes=$(tmux list-panes -a -f '#{?#{m:*~[0-9]*,#{session_name}},0,1}' -F $'#{pane_id}\x1f#{session_name}:#{window_index}.#{pane_index}\x1f#{session_name}\x1f#{window_name}\x1f#{@omo_transcript}')
  for file in "$running"/*.json; do
    [[ -f $file ]] || continue
    IFS=$'\x1f' read -r sid pid rsocket rserver pane _ <<<"$(record_fields "$file")"
    # A record from an earlier tmux server is resurrect's to judge.
    [[ $rsocket == "$socket" && $rserver == "$server" ]] || continue
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$file"
      continue
    fi
    place=$(awk -F$'\x1f' -v p="$pane" '$1 == p { print; exit }' <<<"$panes")
    [[ -n $place ]] || continue
    IFS=$'\x1f' read -r _ target tsession window _ <<<"$place"
    new=$(jq -c --arg target "$target" --arg tmuxSession "$tsession" --arg window "$window" \
      '.target = $target | .tmuxSession = $tmuxSession | .window = $window' "$file" 2>/dev/null) || continue
    [[ $new == "$(jq -c . "$file" 2>/dev/null)" ]] || { printf '%s\n' "$new" >"$file.$$" && mv "$file.$$" "$file"; }
  done
  while IFS=$'\x1f' read -r pane target tsession window transcript; do
    [[ -n $transcript && -r $transcript ]] || continue
    sid=$(sid_of "$transcript")
    [[ -f $running/$sid.json ]] && continue
    pid=$(holder_pid "$sid") || continue
    jq -cn --arg sid "$sid" --argjson pid "$pid" --arg cwd "$(session_cwd "$transcript")" --arg file "$transcript" \
      --arg name "$(session_name "$transcript")" --arg pane "$pane" --arg socket "$socket" --argjson server "$server" \
      --arg target "$target" --arg tmuxSession "$tsession" --arg window "$window" --argjson now "$(now_ms)" \
      '{sid: $sid, pid: $pid, cwd: $cwd, sessionFile: $file, name: $name, pane: $pane, socket: $socket, server: $server,
        target: $target, window: $window, tmuxSession: $tmuxSession, startedAt: $now, adopted: true}
       | with_entries(select(.value != ""))' >"$running/.$sid.tmp" && mv "$running/.$sid.tmp" "$running/$sid.json"
  done <<<"$panes"
  rmdir "$running/.snapshot"
  "$HOME/.local/bin/omo-status" herdr-save >/dev/null 2>&1
  return 0
}

# Reopens the omo sessions that ended with an earlier tmux server: a logout, a reboot or a crash (a session closed on
# purpose left no record). tmux-resurrect's restore hook runs it once the panes are back; --dry-run shows what it
# would do. A session goes back into its restored pane when that pane is there with only a shell in the session's
# folder, else into a new window of its tmux session, a few seconds apart so they don't all load at once. First
# `omo-status reattach` puts Herdr's tabs back on their tmux sessions, so the space sync omo runs as it starts finds
# them shown and opens no second tab. What it did goes to resurrect.log.
cmd_resurrect() {
  local dry="" server socket file sid rsocket rserver cwd sfile target tsession window name pane current folder
  local used=$'\n' reopened=0 shell=${SHELL:-/bin/sh}
  [[ ${1:-} == --dry-run ]] && dry=1
  server=$(tmux display-message -p '#{pid}' 2>/dev/null) || die "no tmux server is running"
  socket=$(tmux display-message -p '#{socket_path}')
  if [[ -z $dry ]]; then
    mkdir -p "$state"
    try_lock "$state/.resurrect" 10 || die "another resurrect is running"
    exec >>"$state/resurrect.log" 2>&1
    note "tmux server $server is up: reattaching Herdr's tabs, then reopening sessions"
    "$HOME/.local/bin/omo-status" reattach
  fi
  for file in "$running"/*.json; do
    [[ -f $file ]] || continue
    IFS=$'\x1f' read -r sid _ rsocket rserver _ cwd sfile target tsession window name <<<"$(record_fields "$file")"
    [[ -n $sid && $rsocket == "$socket" && $rserver != "$server" ]] || continue
    if is_live "$sid"; then
      note "$sid${name:+ ($name)} is open already"
      [[ -n $dry ]] || rm -f "$file"
      continue
    fi
    if [[ ! -r $sfile || ! -d $cwd ]]; then
      note "skipped $sid${name:+ ($name)}: $([[ -r $sfile ]] && echo "its folder $cwd is gone" || echo "its transcript is gone")"
      [[ -n $dry ]] || rm -f "$file"
      continue
    fi
    pane=""
    if [[ -n $target ]]; then
      IFS=$'\x1f' read -r pane current folder <<<"$(tmux display-message -p -t "=$target" $'#{pane_id}\x1f#{pane_current_command}\x1f#{pane_current_path}' 2>/dev/null)"
      case $current in
        zsh | bash | fish | sh | -zsh | -bash) ;;
        *) pane="" ;;
      esac
      if [[ -n $pane ]] && { [[ $used == *$'\n'"$pane"$'\n'* ]] || [[ $(cd "$folder" 2>/dev/null && pwd -P) != "$(cd "$cwd" && pwd -P)" ]]; }; then
        pane=""
      fi
    fi
    if [[ -n $dry ]]; then
      if [[ -n $pane ]]; then note "would reopen $sid${name:+ ($name)} in its pane $target ($pane)"; else note "would reopen $sid${name:+ ($name)} in a new window of ${tsession:-a new tmux session}"; fi
      continue
    fi
    # Gone first: the session writes its own record as it starts.
    rm -f "$file"
    if [[ -n $pane ]]; then
      tmux respawn-pane -k -t "$pane" -c "$cwd" -- "$shell" -lic "$(omo_command --session "$sid")" || pane=""
    else
      pane=$(launch "$cwd" "$tsession" "${window:-${name:-omo}}" "" --session "$sid")
    fi
    if [[ -z $pane ]]; then
      note "couldn't reopen $sid${name:+ ($name)}: resume it with omo-sessions resume $sid"
      continue
    fi
    used+="$pane"$'\n'
    reopened=$((reopened + 1))
    note "reopened $sid${name:+ ($name)} in $pane"
    sleep 3
  done
  [[ -n $dry ]] && return 0
  note "reopened $reopened session(s)"
  rmdir "$state/.resurrect"
}

# The launchd agent's job at login (`install`): starts the tmux server if none runs, so tmux-continuum restores the
# last save and tmux-resurrect's restore hook runs `resurrect`. tmux starts through the login shell, so its panes get
# what a terminal's shell has, and in session "0", which tmux-resurrect drops once it has restored the others.
cmd_boot() {
  tmux list-sessions >/dev/null 2>&1 && return 0
  "${SHELL:-/bin/zsh}" -lic 'tmux new-session -d' </dev/null >/dev/null 2>&1
}

cmd_install() {
  [[ $(uname) == Darwin ]] || die "install sets up a launchd agent, for a Mac"
  local label=local.omo-sessions-boot plist log=$state/boot.log
  plist="$HOME/Library/LaunchAgents/$label.plist"
  mkdir -p "$state" "${plist%/*}"
  # launchd's own PATH would start this script with macOS's bash 3.2, and its environment has no locale, which tmux
  # gives every pane it starts. AbandonProcessGroup keeps the tmux server when the job ends.
  cat >"$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$HOME/.local/bin/omo-sessions</string>
    <string>boot</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin</string>
    <key>LANG</key>
    <string>${LANG:-en_US.UTF-8}</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$log</string>
  <key>StandardErrorPath</key>
  <string>$log</string>
</dict>
</plist>
PLIST
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null
  launchctl bootstrap "gui/$(id -u)" "$plist" && echo "omo-sessions: tmux starts at login and brings its sessions back ($plist)"
}

command=${1:-help}
[[ $# -gt 0 ]] && shift
case $command in
  file) cmd_file "$@" ;;
  unfile) cmd_unfile "$@" ;;
  taken) cmd_taken "$@" ;;
  list) cmd_list ;;
  park) cmd_park "$@" ;;
  resume) cmd_resume "$@" ;;
  fresh) cmd_fresh "$@" ;;
  open) cmd_open "$@" ;;
  handoff) cmd_handoff "$@" ;;
  start) cmd_start "$@" ;;
  title) cmd_title "$@" ;;
  hook) cmd_hook ;;
  deliver) cmd_deliver "$@" ;;
  snapshot) cmd_snapshot ;;
  resurrect) cmd_resurrect "$@" ;;
  boot) cmd_boot ;;
  install) cmd_install ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
