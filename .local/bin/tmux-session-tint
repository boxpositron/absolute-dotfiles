#!/usr/bin/env bash
# A colour per tmux session, so sessions look apart at a glance in Herdr's Agents tree.
#
# The colours come from PALETTE, in order: the first session gets the first colour, the next the second,
# and so on round the list. The list is ordered so that each colour is far round the wheel from the one
# before it, so sessions next to each other always contrast. The order is the one Herdr's Agents tree
# shows (it passes it with --order, which this keeps in $ORDER); sessions it hasn't placed follow, in
# tmux's order. A session coming, going or moving can recolour the ones after it.
#
# Each session keeps its colour in the session option @tint_color, which Herdr's Agents tree washes the
# session's rows with, through `omo-status tints`. Its panes keep the terminal's own background.
#
# Usage: tmux-session-tint                    colour every session, in the saved order
#        tmux-session-tint --order <name...>  the sessions in the order Herdr shows them; colours every
#                                             session and prints "<name>|^|<colour>" for each
#        tmux-session-tint --palette          the colours, one per line

# A tmux server Herdr started has a bare PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
tmux() { command tmux -u "$@"; }

# Blue, orange, teal, magenta, lime, violet, gold, cyan, coral, green: each 115 to 175 degrees of hue
# from the one before. No yellow (Herdr marks other machines in it) and no pure red (the focused pane's edge).
PALETTE=("#4c8dff" "#ff8a3d" "#1fc7a6" "#e64c9a" "#9bd43a" "#9a6bff" "#e8b730" "#2bb8e0" "#ff5a5f" "#3fbf6a")
ORDER=${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/session-order

# Every session, "<id>\t<name>\t<colour now>\t<place>", in the saved order, then tmux's. Not the sessions of tab
# mode's Herdr tabs ("<session>~<window>", see omo-status tabs), which are their session's.
placed() {
  tmux list-sessions -f '#{?#{m:*~[0-9]*,#{session_name}},0,1}' -F $'#{session_id}\t#{session_name}\t#{@tint_color}' 2>/dev/null |
    awk -F'\t' -v order="$ORDER" '
      BEGIN { n = 0; while ((getline line < order) > 0) if (line != "" && !(line in pos)) pos[line] = n++ }
      { id[NR] = $1; name[NR] = $2; now[NR] = $3; rank[NR] = ($2 in pos) ? pos[$2] : 100000 + NR; at[NR] = NR }
      END {
        for (i = 2; i <= NR; i++) { v = at[i]; j = i - 1; while (j >= 1 && rank[at[j]] > rank[v]) { at[j + 1] = at[j]; j-- } at[j + 1] = v }
        for (i = 1; i <= NR; i++) printf "%s\t%s\t%s\t%d\n", id[at[i]], name[at[i]], now[at[i]], i - 1
      }'
}

colour_all() {
  local id name now place colour cmds=()
  while IFS=$'\t' read -r id name now place; do
    colour=${PALETTE[place % ${#PALETTE[@]}]}
    [[ $now == "$colour" ]] || cmds+=(set-option -t "$id" @tint_color "$colour" \; set-option -u -t "$id" @tint_hue \;)
    [[ -z ${PRINT:-} ]] || printf '%s|^|%s\n' "$name" "$colour"
  done < <(placed)
  ((${#cmds[@]})) && tmux "${cmds[@]}"
}

case ${1:-} in
  --palette) printf '%s\n' "${PALETTE[@]}" ;;
  --order)
    shift
    mkdir -p "$(dirname "$ORDER")" && printf '%s\n' "$@" >"$ORDER"
    PRINT=1 colour_all
    ;;
  *) colour_all ;;
esac
exit 0
