#!/usr/bin/env bash
# Coloured attention markers on Ghostty tabs for omo sessions, and the same
# state reported to Herdr. tmux puts the session's @omo_status in front of the
# tab title (set-titles-string in ~/.tmux.conf), so each tab shows what its
# agents need:
#   🔴 stopped with an error   🟡 waiting for your answer
#   🟢 finished                🔵 working
# An omo at rest (idle) shows no marker.
# Each pane running omo keeps its own state in the pane option @omo_state and a
# one-line message in @omo_msg ("Finished: fix the imap timeouts"), and the tab
# shows the most urgent one. Focusing the tab turns red, amber and green back to
# idle, and selects the pane whose banner you were sent (@omo_jump, set by
# omo-notify). It also clears any title you gave the Ghostty tab by hand, so
# tabs always show their tmux session's name.
#
# Herdr: omo inside tmux cannot report its state through tmux, so a tmux client
# running in a Herdr terminal gets its session's most urgent state and message
# as an OSC 7501 program status report. Herdr's sidebar, tab dots, sounds and
# toasts then cover omo inside tmux. @omo_herdr marks a session a Herdr client
# shows, and omo-notify leaves the sounds and banners to Herdr there. Ghostty
# clients get no report. Spec: https://www.superlogical.com/rex/docs/build/program-status
#
# Usage: omo-status set <pane> <working|input|done|error|idle|clear> [message]
#          (prints the message it stored; working with a message sets the task)
#        omo-status tty <tty> <state> [message]   (omo outside tmux, in Herdr)
#        omo-status focus <client>   (run by the tmux client-focus-in hook)
#        omo-status sync <client>    (run when a client attaches or switches session)
#        omo-status show <pane>      (shows the pane in Herdr: the tab already on its session,
#                                     else a tab in the space named after the session, else a
#                                     new space for the session)
#        omo-status spaces [--local] (a Herdr space for every tmux session running omo; closes
#                                     the spaces it made for sessions that ended. --local opens
#                                     spaces only for this computer's sessions)
#        omo-status open <target> [<host>]
#                                    (Telegram's "Open on Mac": shows a board session's tmux
#                                     target in Herdr and brings Herdr forward; a host that is a
#                                     Herdr machine's makes it that machine's pane)
#        omo-status next             (shows the pane that most needs you: a question or a
#                                     failure, then a finished turn, the longest waiting first)
#        omo-status list             (every pane running omo, for Herdr's "omo in tmux" panel:
#                                     pane, session, window, folder, state, since, message)
#        omo-status panes            (every tmux pane, for Herdr's search)
#
# list, panes, show, next and spaces also cover the tmux of each Herdr machine
# herdr-core is connected to (`hc machine ls`): there this script runs, through
# `hc exec --on`, as list-here, panes-here, locate and herdr-sessions, and its
# panes and sessions come back as "<machine>/%3" and "<machine>/<session>".

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

# The spaces `show` and `spaces` made, one "<session>\t<space id>" line each, so
# `spaces` can close them once their session ends.
spaces_file="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/spaces"

icon() {
  case $1 in
    error) echo "🔴" ;;
    input) echo "🟡" ;;
    done) echo "🟢" ;;
    working) echo "🔵" ;;
  esac
}

rank() {
  case $1 in
    error) echo 5 ;;
    input) echo 4 ;;
    done) echo 3 ;;
    working) echo 2 ;;
    idle) echo 1 ;;
    *) echo 0 ;;
  esac
}

# What a state says when omo-notify gives no message: the task is the first
# line of the prompt being worked on.
message_for() {
  local state=$1 message=$2 task=$3
  case $state in
    working) echo "${message:-${task:-Working}}" ;;
    input) echo "${message:-Needs your input}" ;;
    done) echo "${message:-${task:+Finished: $task}}" | sed 's/^$/Task finished/' ;;
    error) echo "${message:-${task:+Failed: $task}}" | sed 's/^$/Stopped with an error/' ;;
  esac
}

# An OSC 7501 report body. No state clears the terminal's records.
report_body() {
  local state=$1 msg=$2 title=$3 body
  case $state in
    "") echo "state=clear" && return ;;
    input) body="state=blocked:kind=question:app=omo" ;;
    *) body="state=$state:app=omo" ;;
  esac
  [[ -n $msg ]] && body+=":msg=$(printf '%s' "$msg" | base64 | tr -d '\n')"
  [[ -n $title ]] && body+=":title=$(printf '%s' "${title:0:60}" | base64 | tr -d '\n')"
  echo "$body"
}

# Names the Herdr tabs of these terminals after the work, so Herdr's agents list
# reads "<space> · <label>" rather than the session's name twice. A tab you
# named stays yours: only tabs called by their number, or by the label this put
# there last, change.
label_tabs() {
  local label=$1 last=$2 tabs
  shift 2
  tabs=$(herdr-app ls 2>/dev/null | jq -r --argjson t "$(printf '%s\n' "$@" | jq -R . | jq -cs .)" --arg last "$last" \
    '.spaces[].tabs[] | select(any(.terminals[]; .terminal as $a | $t | index($a))) | select((.name | test("^[0-9]+$")) or .name == $last) | .id')
  for tab in $tabs; do herdr-app "do" tab.rename --id "$tab" --name "$label" >/dev/null 2>&1; done
}

send_report() {
  [[ -w $1 ]] && printf '\033]7501;%s\033\\' "$2" >"$1"
}

# The Herdr terminal a tmux client runs in, if any: herdr-core gives the programs
# in its terminals HC_TERMINAL_ID, and a client keeps the environment it started with.
herdr_terminal() {
  if [[ -r /proc/$1/environ ]]; then
    tr '\0' '\n' <"/proc/$1/environ" | sed -n 's/^HC_TERMINAL_ID=//p' | head -n 1
  else
    ps eww -o command= -p "$1" 2>/dev/null | tr ' ' '\n' | sed -n 's/^HC_TERMINAL_ID=//p' | head -n 1
  fi
}

# Names of the tmux sessions a Herdr terminal shows: their clients run in herdr-core.
herdr_sessions() {
  local pid session
  while read -r pid session; do
    [[ -n $(herdr_terminal "$pid") ]] && printf '%s\n' "$session"
  done < <(tmux list-clients -F '#{client_pid} #{session_name}')
}

# Herdr machines herdr-core is connected to. Only where the Herdr app runs: on a
# machine itself this finds none, so it never reaches further.
machines() {
  command -v herdr-app >/dev/null && command -v hc >/dev/null || return 0
  hc machine ls --json 2>/dev/null | jq -r '.machines[] | select(.state == "connected" and (.temporary | not)) | .name'
}

# This script with these arguments, here, or on Herdr machine <machine> when one is named.
at() {
  local machine=$1
  shift
  if [[ -z $machine ]]; then
    "$0" "$@"
  else
    hc exec --on "$machine" --timeout 5 sh -c 'exec "$HOME/.local/bin/omo-status" "$@"' omo-status "$@"
  fi
}

# A machine's rows, its name in front of the pane and the session ("flowstate-remote/%3").
prefixed() {
  local machine=$1 line
  while IFS= read -r line; do
    [[ -n $line ]] && printf '%s/%s\n' "$machine" "${line/"|^|"/"|^|$machine/"}"
  done
}

# A tab attached to a tmux session, in the Herdr space named after it, else in a
# new space for it in <folder>, on <machine> when the session lives on one. A
# space this makes goes in $spaces_file.
open_space() {
  local session=$1 folder=$2 target=$3 machine=${4:-} argv space made
  argv=$(jq -cn --arg t "$target" '["tmux", "attach-session", "-t", $t]')
  space=$(herdr-app ls 2>/dev/null | jq -r --arg n "$session" --arg m "$machine" \
    'first(.spaces[] | select(.name == $n and (.machine // "") == $m) | .id) // empty')
  if [[ -n $space ]]; then
    herdr-app "do" tab.new --space "$space" --name "$session" --argv "$argv" >/dev/null
    return
  fi
  made=$(herdr-app "do" space.new --name "$session" --folder "$folder" ${machine:+--machine "$machine"} --argv "$argv") || return 1
  space=$(jq -r '.space // empty' <<<"$made")
  [[ -n $space ]] || return 1
  mkdir -p "$(dirname "$spaces_file")"
  printf '%s\t%s\n' "${machine:+$machine/}$session" "$space" >>"$spaces_file"
}

forget() {
  tmux set-option -p -u -t "$1" @omo_state \; set-option -p -u -t "$1" @omo_msg \; set-option -p -u -t "$1" @omo_task \
    \; set-option -p -u -t "$1" @omo_since
}

# Puts the session's most urgent state in its tab marker and reports it, with its
# message, to the Herdr clients showing the session when it changed. A pane back
# at its shell prompt no longer runs omo, so its state goes.
show_most_urgent() {
  local session=$1 pane cmd state msg path window task best="" best_msg="" label="" body last pid tty term herdr=() old_label
  while IFS=$'\x1f' read -r pane cmd state msg path window task; do
    [[ -n $state ]] || continue
    case $cmd in
      zsh | bash | fish | sh | dash | -zsh | -bash)
        forget "$pane"
        continue
        ;;
    esac
    if (($(rank "$state") > $(rank "$best"))); then
      best=$state best_msg=${msg:+${path##*/}: $msg}
      # The label: a window named for the work (an owt title), else the task.
      case $window in
        bun | node | omo | zsh | bash | fish | sh) label=${task:-${path##*/}} ;;
        mosh-client | ssh) label="" ;; # a server's session: its work is named there
        *) label=$window ;;
      esac
    fi
  done < <(tmux list-panes -s -t "$session" -F $'#{pane_id}\x1f#{pane_current_command}\x1f#{@omo_state}\x1f#{@omo_msg}\x1f#{pane_current_path}\x1f#{window_name}\x1f#{@omo_task}')
  ((${#label} > 40)) && label="${label:0:39}…"
  if [[ -n $(icon "$best") ]]; then
    tmux set-option -t "$session" @omo_status "$(icon "$best")"
  else
    tmux set-option -u -t "$session" @omo_status
  fi
  body=$(report_body "$best" "$best_msg" "$label")
  last=$(tmux show-option -qv -t "$session" @omo_report)
  while read -r pid tty; do
    term=$(herdr_terminal "$pid")
    [[ -n $term ]] || continue
    herdr+=("$term")
    [[ $body == "$last" ]] || send_report "$tty" "$body"
  done < <(tmux list-clients -t "$session" -F '#{client_pid} #{client_tty}')
  tmux set-option -t "$session" @omo_report "$body"
  if ((${#herdr[@]})); then
    tmux set-option -t "$session" @omo_herdr 1
    old_label=$(tmux show-option -qv -t "$session" @omo_label)
    if [[ -n $label && $label != "$old_label" ]]; then
      tmux set-option -t "$session" @omo_label "$label"
      label_tabs "$label" "$old_label" "${herdr[@]}" &
    fi
  else
    tmux set-option -u -t "$session" @omo_herdr
  fi
}

# You are looking at a pane when its tab has focus and its window is showing.
# tmux marks a client in a Herdr terminal focused even while its space is hidden
# (Herdr sends it no focus-out), so only other clients count; for Herdr, its
# focus-in hook (omo-status focus) clears the pane when you go there.
looking_at() {
  local pane=$1 session=$2 pid flags
  [[ $(tmux display-message -p -t "$pane" '#{window_active}') == 1 ]] || return 1
  while read -r pid flags; do
    [[ $flags == *focused* && -z $(herdr_terminal "$pid") ]] && return 0
  done < <(tmux list-clients -t "$session" -F '#{client_pid} #{client_flags}')
  return 1
}

# A tab renamed in Ghostty ignores tmux's title until the override is cleared.
# Finds the tab by its terminal title, which tmux keeps as "[marker ]<session>".
reset_tab_title() {
  osascript - "$1" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  set sessionName to item 1 of argv
  if application "Ghostty" is not running then return
  tell application "Ghostty"
    repeat with term in (every terminal whose name is sessionName or name ends with (" " & sessionName))
      perform action "set_tab_title:" on term
    end repeat
  end tell
end run
APPLESCRIPT
}

case ${1:-} in
  set)
    pane=${2:?pane id required} state=${3:?state required}
    # Control characters would end the report early.
    message=$(tr -d '\000-\037\177' <<<"${4:-}")
    session=$(tmux display-message -p -t "$pane" '#{session_id}' 2>/dev/null) || exit 0
    task=$(tmux show-option -pqv -t "$pane" @omo_task)
    if [[ $state == working && -n $message ]]; then
      task=$message
      tmux set-option -p -t "$pane" @omo_task "$task"
    fi
    message=$(message_for "$state" "$message" "$task")
    printf '%s\n' "$message"
    if [[ $state != working && $state != idle && $state != clear ]] && looking_at "$pane" "$session"; then
      state=idle
    fi
    # When the pane came into its state, for the time Herdr's panel shows.
    [[ $state == "$(tmux show-option -pqv -t "$pane" @omo_state)" ]] || tmux set-option -p -t "$pane" @omo_since "$(date +%s)"
    case $state in
      clear) forget "$pane" ;;
      idle) tmux set-option -p -t "$pane" @omo_state idle \; set-option -p -u -t "$pane" @omo_msg ;;
      *) tmux set-option -p -t "$pane" @omo_state "$state" \; set-option -p -t "$pane" @omo_msg "$message" ;;
    esac
    show_most_urgent "$session"
    ;;
  tty)
    target=${2:?tty required} state=${3:?state required}
    message=$(message_for "$state" "$(tr -d '\000-\037\177' <<<"${4:-}")" "")
    printf '%s\n' "$message"
    [[ $state == clear ]] && state=""
    send_report "$target" "$(report_body "$state" "$message")"
    ;;
  focus)
    client=${2:?client required}
    session=$(tmux list-clients -F '#{client_name} #{session_id}' | awk -v c="$client" '$1 == c { print $2 }')
    [[ -n $session ]] || exit 0
    jump=$(tmux show-option -qv -t "$session" @omo_jump)
    if [[ -n $jump ]]; then
      tmux set-option -u -t "$session" @omo_jump
      tmux select-window -t "$jump" \; select-pane -t "$jump" 2>/dev/null
    fi
    while read -r pane state; do
      case $state in
        input | done | error) tmux set-option -p -t "$pane" @omo_state idle \; set-option -p -u -t "$pane" @omo_msg ;;
      esac
    done < <(tmux list-panes -s -t "$session" -F '#{pane_id} #{@omo_state}')
    show_most_urgent "$session"
    reset_tab_title "$(tmux display-message -p -t "$session" '#{session_name}')"
    ;;
  sync)
    client=${2:?client required}
    read -r session pid tty < <(tmux list-clients -F '#{client_name} #{session_id} #{client_pid} #{client_tty}' |
      awk -v c="$client" '$1 == c { print $2, $3, $4 }')
    [[ -n $session ]] || exit 0
    show_most_urgent "$session"
    # A client that just arrived holds the report of where it was before, or none. An if, not &&: a client
    # outside Herdr (Ghostty) must still exit 0, or tmux prints "... returned 1" in the pane.
    if [[ -n $(herdr_terminal "$pid") ]]; then
      send_report "$tty" "$(tmux show-option -qv -t "$session" @omo_report)"
    fi
    ;;
  list | panes)
    "$0" "$1-here"
    for machine in $(machines); do
      at "$machine" "$1-here" 2>/dev/null | prefixed "$machine"
    done
    ;;
  panes-here)
    tmux -u list-panes -a -F '#{pane_id}|^|#{session_name}|^|#{session_attached}|^|#{window_index}|^|#{window_name}|^|#{window_active}|^|#{pane_index}|^|#{pane_active}|^|#{pane_current_command}|^|#{pane_current_path}|^|#{@omo_state}|^|#{@omo_msg}'
    ;;
  herdr-sessions)
    herdr_sessions
    ;;
  list-here)
    # omo holds its Stop hook while a background task (a terminal monitor, a child
    # session) is live, so a pane can stay "working" after its turn ended. Its
    # transcript's last session-lifecycle entry says so: waiting_* means it is idle.
    while IFS=$'\x1f' read -r pane transcript; do
      [[ -r $transcript ]] || continue
      lifecycle=$(tail -c 300000 "$transcript" | grep '"customType":"session-lifecycle"' | tail -n 1 | jq -r '.data.state // empty' 2>/dev/null)
      [[ $lifecycle == waiting_* ]] && "$0" set "$pane" idle >/dev/null
    done < <(tmux list-panes -a -F $'#{pane_id}\x1f#{@omo_transcript}\x1f#{@omo_state}' | awk -F$'\x1f' '$3 == "working" && $2 != "" { print $1 "\037" $2 }')
    # omo is bun running senpi's CLI (or omo's launcher) on the pane's terminal. A
    # pane omo's hooks haven't reached yet is idle; a pane connected to a server
    # (mosh, ssh) shows the state its title brought. Fields are split by "|^|",
    # because tmux prints control characters as "_" when Herdr runs it.
    omo_ttys=$(ps -A -o tty=,args= |
      awk '$1 != "??" && /\/senpi\/dist\/bundle\/cli\.js|\/omo-ai\/bin\/omo\.js/ { print "/dev/" $1 }' | sort -u)
    tmux -u list-panes -a -F '#{pane_tty}|^|#{pane_current_command}|^|#{pane_id}|^|#{session_name}|^|#{window_name}|^|#{pane_current_path}|^|#{@omo_state}|^|#{@omo_since}|^|#{@omo_msg}' |
      OMO_TTYS=$omo_ttys awk '
        function fields(s, f,   n, i) {
          n = 0
          while ((i = index(s, "|^|")) > 0) { f[++n] = substr(s, 1, i - 1); s = substr(s, i + 3) }
          f[++n] = s
          return n
        }
        BEGIN { n = split(ENVIRON["OMO_TTYS"], t, "\n"); for (i = 1; i <= n; i++) omo[t[i]] = 1 }
        {
          n = fields($0, f)
          state = f[7]
          if (f[1] in omo) { if (state == "") state = "idle" }
          else if (!((f[2] == "mosh-client" || f[2] == "ssh") && state != "")) next
          msg = f[9]
          for (i = 10; i <= n; i++) msg = msg "|^|" f[i]
          print f[3] "|^|" f[4] "|^|" f[5] "|^|" f[6] "|^|" state "|^|" f[8] "|^|" msg
        }'
    ;;
  locate)
    # Selects the pane and prints "<Herdr terminal on its session>\x1f<session>\x1f<folder>",
    # the terminal empty when no Herdr terminal shows the session.
    pane=${2:?pane id required} terminal=""
    session=$(tmux display-message -p -t "$pane" '#{session_id}' 2>/dev/null) || exit 1
    tmux select-window -t "$pane" \; select-pane -t "$pane"
    # Going to a pane is looking at it. A Herdr client gets no focus-in hook for it
    # (tmux already counts it focused), so a finished or waiting pane clears here.
    case $(tmux show-option -pqv -t "$pane" @omo_state) in
      input | done | error) "$0" set "$pane" idle >/dev/null ;;
    esac
    while read -r pid client_session; do
      [[ $client_session == "$session" ]] || continue
      terminal=$(herdr_terminal "$pid")
      [[ -n $terminal ]] && break
    done < <(tmux list-clients -F '#{client_pid} #{session_id}')
    printf '%s\x1f%s\x1f%s\n' "$terminal" "$(tmux display-message -p -t "$pane" '#{session_name}')" \
      "$(tmux display-message -p -t "$pane" '#{pane_current_path}')"
    ;;
  show)
    pane=${2:?pane id required} machine=""
    [[ $pane == */* ]] && machine=${pane%%/*} pane=${pane#*/}
    IFS=$'\x1f' read -r terminal session folder < <(at "$machine" locate "$pane") || exit 1
    if [[ -n $terminal ]]; then
      herdr-app "do" pane.focus --terminal "${machine:+$machine/}$terminal" >/dev/null
    else
      open_space "$session" "$folder" "$pane" "$machine"
    fi
    ;;
  open)
    target=${2:?tmux target required} host=${3:-} machine=""
    if [[ -n $host ]] && command -v hc >/dev/null; then
      machine=$(hc machine ls --json 2>/dev/null |
        jq -r --arg h "$host" 'first(.machines[] | select(.host == $h and .state == "connected") | .name) // empty')
    fi
    "$0" show "${machine:+$machine/}$target" || exit 1
    open -a Herdr 2>/dev/null
    ;;
  next)
    pane=$("$0" list | awk -F'[|][\\^][|]' '
      $5 == "input" || $5 == "error" { r = 2 } $5 == "done" { r = 1 } $5 != "input" && $5 != "error" && $5 != "done" { next }
      { print r "\t" ($6 == "" ? 0 : $6) "\t" $1 }' | sort -t$'\t' -k1,1nr -k2,2n | head -n 1 | cut -f3)
    [[ -n $pane ]] || { echo "nothing needs you" >&2; exit 1; }
    exec "$0" show "$pane"
    ;;
  spaces)
    # One sync at a time: tmux and omo hooks can start several together.
    lock="${spaces_file%/*}/spaces.lock"
    mkdir -p "${spaces_file%/*}"
    mkdir "$lock" 2>/dev/null || exit 0
    trap 'rmdir "$lock"' EXIT
    here=$(herdr-app status 2>/dev/null | jq -r '.space // empty')
    connected=$(machines)
    shown=$'\n'"$(herdr_sessions)"$'\n'
    # --local (omo's start hook, tmux's session-closed hook): a server's session
    # gets a Herdr client, which resizes it under your mosh client, only on request.
    rows=list
    if [[ ${2:-} == --local ]]; then
      rows=list-here
    else
      for machine in $connected; do
        shown+="$(at "$machine" herdr-sessions 2>/dev/null | sed "s|^|$machine/|")"$'\n'
      done
    fi
    opened=0 closed=0
    while IFS= read -r line; do
      pane=${line%%"|^|"*} rest=${line#*"|^|"}
      session=${rest%%"|^|"*} rest=${rest#*"|^|"}
      rest=${rest#*"|^|"} folder=${rest%%"|^|"*}
      [[ $shown == *$'\n'"$session"$'\n'* ]] && continue
      shown+="$session"$'\n'
      machine=""
      [[ $pane == */* ]] && machine=${pane%%/*} pane=${pane#*/} session=${session#*/}
      open_space "$session" "$folder" "$pane" "$machine" && opened=$((opened + 1))
    done < <("$0" "$rows")
    if [[ -f $spaces_file ]]; then
      kept=""
      while IFS=$'\t' read -r session space; do
        machine="" name=$session alive=1
        [[ $session == */* ]] && machine=${session%%/*} name=${session#*/}
        if [[ -z $machine ]]; then
          tmux has-session -t "=$name" 2>/dev/null || alive=""
        elif [[ $'\n'$connected$'\n' == *$'\n'"$machine"$'\n'* ]]; then
          hc exec --on "$machine" --timeout 5 tmux has-session -t "=$name" >/dev/null 2>&1 || alive=""
        fi # a machine that is away keeps its spaces: its sessions may well live on
        if [[ -n $alive ]]; then
          kept+="$session"$'\t'"$space"$'\n'
        else
          herdr-app "do" space.close --id "$space" --confirmed true >/dev/null 2>&1 && closed=$((closed + 1))
        fi
      done <"$spaces_file"
      printf '%s' "$kept" >"$spaces_file"
    fi
    [[ -n $here ]] && herdr-app "do" space.select --id "$here" >/dev/null
    echo "opened $opened space(s), closed $closed"
    ;;
  *)
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
    exit 2
    ;;
esac
