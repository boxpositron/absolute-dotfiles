#!/usr/bin/env bash
# Coloured attention markers on Ghostty tabs for omo sessions, and the same
# state reported to Herdr. tmux puts the session's @omo_status in front of the
# tab title (set-titles-string in ~/.tmux.conf), so each tab shows what its
# agents need:
#   🔴 stopped with an error   🟡 waiting for your answer
#   🟢 finished                🔘 finished a step, with tasks still open
#   🔵 working
#   🟣 turn over, but a build, watcher or child session still runs, or a wake-up is scheduled
# An omo at rest (idle) shows no marker.
# Each pane running omo keeps its own state in the pane option @omo_state and a
# one-line message in @omo_msg ("Finished: fix the imap timeouts"), and the tab
# shows the most urgent one. Focusing the tab selects the pane that most needs
# you and turns only that one back to idle, so the tab keeps its next most urgent
# state until each pane has been seen. With none left it selects the pane whose
# banner you were sent (@omo_jump, set by omo-notify). It also clears any title you gave the Ghostty tab by hand, so
# tabs always show their tmux session's name.
#
# Herdr: omo inside tmux cannot report its state through tmux, so a tmux client
# running in a Herdr terminal gets its session's most urgent state and message
# as an OSC 7501 program status report. Herdr's sidebar, tab dots, sounds and
# toasts then cover omo inside tmux. @omo_herdr marks a session a Herdr client
# shows, and omo-notify leaves the sounds and banners to Herdr there. Ghostty
# clients get no report. Spec: https://www.superlogical.com/rex/docs/build/program-status
#
# A turn that ends while omo's todo list still has tasks open (pending or in progress) finished
# a step of the work, not the work: `set <pane> done` makes it "partial" (step done) with what is
# left, "4 of 9 left · next: <task>", from the session's transcript (@omo_transcript). Herdr gets
# it as done, its message saying so; the Herdr panels here draw it as a ring with a dot.
#
# Usage: omo-status set <pane> <working|background|input|done|partial|error|idle|clear> [message]
#        omo-status name <pane> [name]   the omo session's name, which labels its Herdr tab (none: forget it)
#          (prints the message it stored; working with a message sets the task)
#        omo-status tty <tty> <state> [message]   (omo outside tmux, in Herdr)
#        omo-status focus <client>   (run by the tmux client-focus-in hook)
#        omo-status sync <client>    (run when a client attaches or switches session)
#        omo-status refresh          (run when a pane or window closes: each session still
#                                     reporting an agent works its state out again)
#        omo-status show <pane> [exact]
#                                    (shows the pane in Herdr: the tab already on its session,
#                                     else a tab in the space named after the session, else a
#                                     new space for the session. A pane that needs nothing gives
#                                     way to its session's most urgent pane, unless exact)
#        omo-status spaces [--local] (a Herdr space for every tmux session running omo; closes
#                                     the spaces it made for sessions that ended. --local opens
#                                     spaces only for this computer's sessions)
#        omo-status open <target> [<host>]
#                                    (Telegram's "Open on Mac": shows a board session's tmux
#                                     target in Herdr and brings Herdr forward; a host that is a
#                                     Herdr machine's makes it that machine's pane)
#        omo-status next             (shows the pane that most needs you: a question or a
#                                     failure, then a finished turn, the longest waiting first)
#        omo-status ack <pane>       (Herdr's priority queue: a finished turn or failure seen there
#                                     goes back to idle, as looking at the pane would; <machine>/<pane>
#                                     for another machine's, whose list Herdr then reads at once)
#        omo-status list             (every pane running omo, for Herdr's "omo in tmux" panel:
#                                     pane, session, window, folder, state, since, scheduled wake-up, message)
#        omo-status panes            (every tmux pane, for Herdr's search)
#        omo-status sessions         (every tmux session, for Herdr's search: name, windows, clients,
#                                     whether a Herdr terminal shows it, folder, last activity)
#        omo-status tints            (every tmux session's colour from tmux-session-tint, for Herdr's
#                                     Agents tree: session, #rrggbb)
#        omo-status session <name> [<machine>]
#                                    (shows tmux session <name> in Herdr as show does, starting it
#                                     first in your home folder when there is none; on Herdr machine
#                                     <machine> when one is named)
#        omo-status where <terminal> (the tmux pane a Herdr terminal's tmux client shows, for
#                                     Herdr's Files and Changes panels: a "client|^|<pane>" line,
#                                     then one "pane|^|..." line per pane in its session; nothing
#                                     when the terminal runs no tmux client)
#        omo-status mcp <pane> [machine]
#                                    (the MCP servers the omo session in tmux pane <pane> gets, from
#                                     omo's config, sign-ins and caches: one JSON object, for Herdr's
#                                     MCP panel; nothing when that tmux session runs no omo)
#        omo-status list-local | list-remote
#                                    (list in two parts, for Herdr's omo panel: this Mac's panes,
#                                     after noting a Herdr focus change; the connected machines')
#        omo-status follow           (run by the launchd agent: each connected Herdr machine says when
#                                     its omo state changes, so Herdr's omo panel reads that machine's
#                                     list at once rather than at its next look)
#        omo-status install          (install and start that launchd agent, on a Mac)
#        omo-status jobs             (every background job of every omo pane, for Herdr's jobs panel, one
#                                     line each: pane, session, window, folder, kind (monitor, command, cell,
#                                     child, wakeup, goal), started, due, label; here and on each Herdr machine)
#        omo-status jobs-here | jobs-remote
#                                    (jobs in two parts: this computer's panes; the connected machines')
#        omo-status herdr-save       (notes which tmux session each Herdr terminal shows, for reattach; run at
#                                     each tmux-resurrect save by omo-sessions snapshot)
#        omo-status reattach [<max age, seconds>]
#                                    (after a logout or reboot, puts the shells Herdr's tabs are left with back
#                                     on the tmux sessions they showed; Herdr runs it as it starts)
#        omo-status tabs [<machine>/]<session>|--all [on|off]
#                                    (tab mode for tmux session <session>, here or on Herdr machine <machine>: each
#                                     of its windows gets a Herdr tab of its own, with its own status; off goes back
#                                     to one tab on the session. --all: every session on every machine, those made
#                                     later too, and <session> off then leaves one out. Without on or off it says
#                                     which it is)
#        omo-status tabs-sync <session>
#                                    (run by tmux's hooks in tab mode: opens a new window's tab, closes the tab of a
#                                     window that closed, and puts a tab moved to another window back; on a Herdr
#                                     machine it notes the session for the Mac, whose follow agent runs
#                                     omo-status tabs-pending <machine>)
#
# list, panes, show, next and spaces also cover the tmux of each Herdr machine
# herdr-core is connected to (`hc machine ls`): there this script runs, through
# `hc exec --on`, as list-here, panes-here, locate and herdr-sessions, and its
# panes and sessions come back as "<machine>/%3" and "<machine>/<session>".

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

# Run from outside tmux with no UTF-8 locale (Herdr's panel, `hc exec`), tmux prints control
# characters as "_", which destroys the tab and \x1f field separators used below.
tmux() { command tmux -u "$@"; }

# A pane whose tmux server lost the default socket to another server, which tmux-rehome then moved aside to
# displaced-<time>-<server pid>, still reaches its own server: $TMUX names the socket's path and the server's pid,
# and only the path changed.
if [[ -n ${TMUX:-} ]]; then
  tmux_rest=${TMUX#*,}
  for moved in "${TMUX%/*}"/displaced-*-"${tmux_rest%%,*}"; do
    [[ -S $moved ]] && export TMUX="$moved,$tmux_rest"
  done
fi

# The spaces `show` and `spaces` made, one "<session>\t<space id>" line each, so
# `spaces` can close them once their session ends.
spaces_file="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/spaces"
# Touched whenever a pane's omo state is set, so Herdr's omo panel reads the list at once
# rather than polling for it.
list_tick="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/list/tick"
# Watched by Herdr's omo panel, which reads the other machines' list at once when it changes: `follow`
# touches tick at each answer from a machine (a change, or the beat that shows the link is up), and
# `ack` touches seen after clearing one of their panes. Only tick tells the panel `follow` is running.
remote_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/remote"
# Herdr's focused agent as herdr_arrival last saw it, and when omo-status or a click in Herdr's
# Agents tree last moved the focus itself (seconds). Files, not tmux options: with a dozen clients
# attached every set-option holds the tmux server for about 0.4 s, and these change on every switch.
herdr_focus_file="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/herdr-focus"
herdr_shown_file="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/herdr-shown"
# What list-here last read for each pane ("<transcript size> <state> <resume> <goal>"), a file per
# pane id, so a pass that finds nothing new reads no transcript. A file, as it changes on most passes.
seen_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/seen"
# Which tmux session each Herdr terminal showed at the last tmux-resurrect save: herdr_attached's
# "<[machine/]session>\t<terminal>" lines, for `reattach`.
herdr_tabs_file="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/herdr-tabs"
# The tmux sessions in tab mode (`tabs`), one name per line: each of their windows gets a Herdr tab of its own.
# A tab runs a tmux client on "<session>~<window id>", a session sharing <session>'s windows (a session group)
# that keeps its own current window, the one its tab shows.
tab_sessions_file="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/tab-sessions"
# Touched by a Herdr machine's tab mode hooks, with the sessions in pending beside it (tabs_request).
tabs_tick="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/tabs/tick"
# A tmux listing filter that leaves those per-tab sessions out: without it each pane of a session in tab
# mode is listed once per tab. The functions sent to other machines with declare -f carry it written out.
real_sessions='#{?#{m:*~[0-9]*,#{session_name}},0,1}'

# From a transcript's session-lifecycle entry: "<lifecycle state>\x1f<what still runs>".
# Only real work counts. The other waitingOn sources are omo's own plumbing (queued
# deliveries, goal timers, open questions), and senpi-task repeats the children count.
background_work='
  .data as $d | ($d.waitingOn // {}) as $w
  | [($w.background // [])[] | select(.source | IN("terminal-monitors", "terminal-background-sessions", "senpi-codemode"))] as $bg
  | (($bg | map(.activeCount // 1) | add // 0) + ($w.children // 0)) as $total
  | any(($w.background // [])[]; .source == "goal-monitor") as $goal
  | (first($bg[] | . as $s | .items[]? | select(.label)
      | {verb: (if $s.source == "terminal-monitors" then "Watching" else "Running" end), label: (.label | gsub("\\s+"; " ") | .[0:80])}) // null) as $named
  | (if $total == 0 then ""
     elif $named then $named.label + (if $total > 1 then " (+\($total - 1) more)" else "" end)
     else "\($total) background task\(if $total > 1 then "s" else "" end)" end) as $what
  | "\($d.state)\u001f" + (
      if $what == "" then (if $goal and ($d.state | test("^waiting_(background|children)$")) then "goal · waiting to continue" else "" end)
      elif $goal then "goal · waiting on \($what)"
      elif $named then "\($named.verb): \($what)"
      else $what end)'

# Each session's soonest scheduled wake-up: "<session id>\t<epoch seconds>\t<prompt's first line>".
scheduled_wakeups() {
  set -- "$HOME/.omo/agent/schedule/pending"/*.json
  [[ -e $1 ]] || return 0
  jq -rs 'group_by(.sessionId) | map(min_by(.dueAt))[]
    | [.sessionId, (.dueAt / 1000 | ceil), (.prompt | split("\n")[0] | gsub("\\s+"; " ") | .[0:60])] | @tsv' "$@" 2>/dev/null
}

# From a transcript's session-lifecycle entry, one "<kind>\t<started, epoch seconds>\t<label>" line for
# each background job the session still has: a terminal monitor, a background command, a detached eval cell,
# a child session (kind monitor, command, cell, child). omo names a child session only by the count.
job_items='
  def secs: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
  def plural($n): if $n > 1 then "s" else "" end;
  (.data.waitingOn // {}) as $w
  | (($w.background // []) | map(select(.source | IN("terminal-monitors", "terminal-background-sessions", "senpi-codemode", "senpi-task")))) as $bg
  | (([$bg[] | select(.source == "senpi-task") | .items[]?] | length) > 0) as $named_children
  | ($bg[] | select(.source != "senpi-task" or $named_children) | . as $s
      | ({"terminal-monitors": "monitor", "terminal-background-sessions": "command", "senpi-codemode": "cell", "senpi-task": "child"}[$s.source]) as $kind
      | if ($s.items // [] | length) > 0 then
          $s.items[] | [$kind, ((.startedAt // .since // .createdAt // null) | if . then (try secs catch 0) else 0 end),
            ((.label // .description // .command // .name // .id // $kind) | tostring | gsub("\\s+"; " ") | .[0:120])]
        else [$kind, 0, "\($s.activeCount // 1) \($kind)\(plural($s.activeCount // 1))"] end),
    (if ($w.children // 0) > 0 and ($named_children | not) then ["child", 0, "\($w.children) child session\(plural($w.children))"] else empty end)
  | @tsv'

# Every scheduled wake-up: "<session id>\t<epoch seconds>\t<prompt's first line>".
all_wakeups() {
  set -- "$HOME/.omo/agent/schedule/pending"/*.json
  [[ -e $1 ]] || return 0
  jq -r '[.sessionId, (.dueAt / 1000 | ceil), ((.prompt // "") | split("\n")[0] | gsub("\\s+"; " ") | .[0:80])] | @tsv' "$@" 2>/dev/null
}

# The background jobs of every pane running omo on this computer, one line each:
# "<pane>|^|<session>|^|<window>|^|<folder>|^|<kind>|^|<started>|^|<due>|^|<label>", in tmux's order. Kinds:
# monitor, command, cell, child (started: epoch seconds, 0 unknown), wakeup (a scheduled wake-up) and
# goal (a parked goal's wait), both with the epoch second they fire in <due>. A transcript is read when it
# grew since the last call (the result is kept per transcript in omo-status/jobs); the rest is tmux options.
# It uses nothing else in this file but job_items, all_wakeups and the tmux wrapper, so `jobs` can send
# it to a Herdr machine with declare -f.
jobs_here() {
  local cache="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/jobs" wake pane transcript state session window path cmd resume goal mins msg
  local sid size file seen rows kind start label wsid due
  mkdir -p "$cache"
  find "$cache" -type f -mtime +3 -delete 2>/dev/null
  wake=$(all_wakeups)
  while IFS=$'\x1f' read -r pane transcript state session window path cmd resume goal mins msg; do
    [[ -n $state && -r $transcript ]] || continue
    case $cmd in zsh | bash | fish | sh | dash | -zsh | -bash) continue ;; esac
    sid=${transcript##*_} sid=${sid%.jsonl}
    size=$(($(wc -c <"$transcript")))
    file=$cache/${transcript##*/} seen=""
    [[ -r $file ]] && IFS= read -r seen <"$file"
    if [[ $seen == "$size" ]]; then
      rows=$(tail -n +2 "$file")
    else
      rows=$(tail -c 300000 "$transcript" | grep -a '"customType":"session-lifecycle"' | tail -n 1 | jq -r "$job_items" 2>/dev/null)
      printf '%s\n%s\n' "$size" "$rows" >"$file"
    fi
    while IFS=$'\t' read -r kind start label; do
      [[ -n $kind ]] && printf '%s|^|%s|^|%s|^|%s|^|%s|^|%s|^||^|%s\n' "$pane" "$session" "$window" "$path" "$kind" "$start" "$label"
    done <<<"$rows"
    if [[ -n $wake ]]; then
      while IFS=$'\t' read -r wsid due label; do
        [[ $wsid == "$sid" ]] && printf '%s|^|%s|^|%s|^|%s|^|wakeup|^|0|^|%s|^|%s\n' "$pane" "$session" "$window" "$path" "$due" "${label:-Scheduled wake-up}"
      done <<<"$wake"
    fi
    # The footer's countdown is read by list-here, which keeps it in these options.
    if [[ $goal == 1 && -n $mins && -n $resume ]]; then
      printf '%s|^|%s|^|%s|^|%s|^|goal|^|0|^|%s|^|%s\n' "$pane" "$session" "$window" "$path" "$resume" "${msg:-Goal waiting to continue}"
    fi
  done < <(tmux list-panes -a -f '#{?#{m:*~[0-9]*,#{session_name}},0,1}' -F $'#{pane_id}\x1f#{@omo_transcript}\x1f#{@omo_state}\x1f#{session_name}\x1f#{window_name}\x1f#{pane_current_path}\x1f#{pane_current_command}\x1f#{@omo_resume}\x1f#{@omo_goal}\x1f#{@omo_goal_mins}\x1f#{@omo_msg}')
}

icon() {
  case $1 in
    error) echo "🔴" ;;
    input) echo "🟡" ;;
    done) echo "🟢" ;;
    partial) echo "🔘" ;;
    working) echo "🔵" ;;
    background) echo "🟣" ;;
  esac
}

rank() {
  case $1 in
    error) echo 6 ;;
    input) echo 5 ;;
    done | partial) echo 4 ;;
    working) echo 3 ;;
    background) echo 2 ;;
    idle) echo 1 ;;
    *) echo 0 ;;
  esac
}

# What a state says when omo-notify gives no message: the task is the first
# line of the prompt being worked on.
message_for() {
  local state=$1 message=$2 task=$3
  case $state in
    working) echo "${message:-${task:-Working}}" ;;
    background) echo "${message:-Running in the background}" ;;
    input) echo "${message:-Needs your input}" ;;
    done) echo "${message:-${task:+Finished: $task}}" | sed 's/^$/Task finished/' ;;
    partial) echo "Step done${message:+ · $message}" ;;
    error) echo "${message:-${task:+Failed: $task}}" | sed 's/^$/Stopped with an error/' ;;
  esac
}

# A parked goal's wait, from the footer omo draws every second (it is stored nowhere else):
# "<continues|retries|resumes> <seconds left>". Nothing while the footer shows no wait.
goal_wait() {
  tmux capture-pane -p -t "$1" | awk '
    match($0, /(▰|▱) (provider unavailable · )?goal (continues|retries|resumes) in [0-9hms ]+/) {
      n = split(substr($0, RSTART, RLENGTH), w, " ")
      for (i = 1; i <= n; i++) if (w[i] == "goal") kind = w[i + 1]
      left = 0
      for (i = n; i >= 1 && w[i] ~ /^[0-9]+[hms]$/; i--) {
        unit = substr(w[i], length(w[i]))
        left += (w[i] + 0) * (unit == "h" ? 3600 : unit == "m" ? 60 : 1)
      }
    }
    END { if (kind != "") print kind, left }'
}

# An OSC 7501 report body. No state clears the terminal's records.
report_body() {
  local state=$1 msg=$2 title=$3 body
  case $state in
    "") echo "state=clear" && return ;;
    input) body="state=blocked:kind=question:app=omo" ;;
    partial) body="state=done:app=omo" ;; # OSC 7501 has no such state; the message says "Step done"
    background) # OSC 7501 has no background state. Not idle: Herdr shows a terminal that goes
      # from working to idle while you aren't looking as done, and this work isn't done yet.
      body="state=working:app=omo"
      case $msg in "goal "*) msg="◐ $msg" ;; *) msg="◐ background · $msg" ;; esac
      ;;
    *) body="state=$state:app=omo" ;;
  esac
  [[ -n $msg ]] && body+=":msg=$(printf '%s' "$msg" | base64 | tr -d '\n')"
  [[ -n $title ]] && body+=":title=$(printf '%s' "${title:0:60}" | base64 | tr -d '\n')"
  echo "$body"
}

# Names the Herdr tabs of these terminals after the work, so Herdr's agents list
# reads "<space> · <label>" rather than the session's name twice. A tab you
# named stays yours: only tabs called by their number, or by the label this put
# there last, change.
label_tabs() {
  local label=$1 last=$2 tabs
  shift 2
  tabs=$(herdr-app ls 2>/dev/null | jq -r --argjson t "$(printf '%s\n' "$@" | jq -R . | jq -cs .)" --arg last "$last" \
    '.spaces[].tabs[] | select(any(.terminals[]; .terminal as $a | $t | index($a))) | select((.name | test("^[0-9]+$")) or .name == $last) | .id')
  for tab in $tabs; do herdr-app "do" tab.rename --id "$tab" --name "$label" >/dev/null 2>&1; done
}

send_report() {
  [[ -w $1 ]] && printf '\033]7501;%s\033\\' "$2" >"$1"
}

# The Herdr terminal a tmux client runs in, if any: herdr-core gives the programs
# in its terminals HC_TERMINAL_ID, and a client keeps the environment it started with.
herdr_terminal() {
  if [[ -r /proc/$1/environ ]]; then
    tr '\0' '\n' <"/proc/$1/environ" | sed -n 's/^HC_TERMINAL_ID=//p' | head -n 1
  else
    ps eww -o command= -p "$1" 2>/dev/null | tr ' ' '\n' | sed -n 's/^HC_TERMINAL_ID=//p' | head -n 1
  fi
}

# Names of the tmux sessions a Herdr terminal shows: their clients run in herdr-core. A tab mode tab shows its
# session's (its own session's name less "~<window>").
herdr_sessions() {
  local pid session
  while read -r pid session; do
    [[ -n $(herdr_terminal "$pid") ]] && printf '%s\n' "$session"
  done < <(tmux list-clients -F '#{client_pid} #{s/~[0-9]+$//:session_name}')
}

# Every tmux session: "<session>|^|<windows>|^|<clients>|^|<1 when a Herdr terminal shows it, else 0>|^|
# <folder>|^|<last activity, epoch seconds>". It uses nothing in this file but the tmux wrapper,
# herdr_terminal and herdr_sessions, so `sessions` can send it to a Herdr machine with declare -f.
tints_here() {
  tmux list-sessions -F '#{session_name}|^|#{@tint_color}' 2>/dev/null | awk -F'[|][\\^][|]' '$2 != ""'
}
sessions_here() {
  local herdr line name windows clients shown
  herdr=$'\n'$(herdr_sessions)$'\n'
  while IFS= read -r line; do
    name=${line%%"|^|"*} line=${line#*"|^|"}
    windows=${line%%"|^|"*} line=${line#*"|^|"}
    clients=${line%%"|^|"*} line=${line#*"|^|"}
    shown=0
    [[ $herdr == *$'\n'"$name"$'\n'* ]] && shown=1
    printf '%s|^|%s|^|%s|^|%s|^|%s\n' "$name" "$windows" "$clients" "$shown" "$line"
  done < <(tmux list-sessions -f '#{?#{m:*~[0-9]*,#{session_name}},0,1}' \
    -F '#{session_name}|^|#{session_windows}|^|#{?session_grouped,#{session_group_attached},#{session_attached}}|^|#{session_path}|^|#{session_activity}' 2>/dev/null)
}

# What omo's todo list in transcript <file> still has open, from its last senpi.todo-state entry:
# "<open> of <all> left · next: <first open task>". Nothing when no task is open or there is no list.
open_todos() {
  [[ -r ${1:-} ]] || return 0
  grep -F '"customType":"senpi.todo-state"' "$1" | tail -n 1 | jq -r '
    [(.data.phases[]?.tasks[]?), (.data.todos[]?)] as $all
    | [$all[] | select(.status == "pending" or .status == "in_progress")] as $open
    | if ($open | length) == 0 then empty
      else "\($open | length) of \($all | length) left · next: \($open[0].content // "" | .[0:80])" end' 2>/dev/null
}

# Herdr's own record of what its terminals are attached to, one
# "<[machine/]session>\t<terminal>\t<window>" line each, <window> the id of the window a tab mode
# tab shows (empty for a client on the session itself). Fails if Herdr or any terminal can't be
# read, so a caller never mistakes "couldn't tell" for "nothing is open".
herdr_attached() {
  local layout=$1 term info pid machine clients="" asked=$'\n' list session window
  # A tab mode tab's client is on "<session>~<window>": it stands for <session>, and the window it shows comes too.
  local format='#{client_pid} #{?#{m:*~[0-9]*,#{session_name}},#{window_id},-} #{s/~[0-9]+$//:session_name}'
  [[ -n $layout ]] || return 1
  for term in $(jq -r '.spaces[].tabs[].terminals[].terminal' <<<"$layout"); do
    info=$(hc get "$term" --json 2>/dev/null) && [[ -n $info ]] || return 1
    # The client's pid, because the session it was started on may not be the one it shows now.
    pid=$(jq -r '.foreground // {} | select(.argv[0:2] == ["tmux", "attach-session"]) | .pid // empty' <<<"$info")
    [[ -n $pid ]] || continue
    machine=""
    [[ $term == */* ]] && machine=${term%%/*}
    if [[ $asked != *$'\n'"$machine"$'\n'* ]]; then
      asked+="$machine"$'\n'
      if [[ -n $machine ]]; then
        list=$(hc exec --on "$machine" --timeout 5 tmux list-clients -F "$format") || return 1
      else
        list=$(tmux list-clients -F "$format") || return 1
      fi
      clients+=$(sed "s|^|$machine/|" <<<"$list")$'\n'
    fi
    read -r _ window session < <(grep -m 1 "^$machine/$pid " <<<"$clients")
    [[ -n $session ]] || return 1
    [[ $window == - ]] && window=""
    printf '%s\t%s\t%s\n' "${machine:+$machine/}$session" "$term" "$window"
  done
}

# A command here, or on Herdr machine <machine> when one is named.
on_machine() {
  local machine=$1
  shift
  if [[ -n $machine ]]; then hc exec --on "$machine" --timeout 5 "$@"; else "$@"; fi
}

# Seconds since process <pid> started, here or on Herdr machine <machine>.
age_of() {
  local etime days=0 parts
  etime=$(on_machine "$1" ps -o etime= -p "$2" 2>/dev/null)
  etime=${etime//[[:space:]]/}
  [[ -n $etime ]] || return 1
  if [[ $etime == *-* ]]; then days=${etime%%-*} etime=${etime#*-}; fi
  IFS=: read -r -a parts <<<"$etime"
  while ((${#parts[@]} < 3)); do parts=(0 "${parts[@]}"); done
  echo $((10#$days * 86400 + 10#${parts[0]} * 3600 + 10#${parts[1]} * 60 + 10#${parts[2]}))
}

# The Herdr terminals with nothing running but their shell: "<terminal>\t<space id>\t<fresh>" lines in Herdr's
# order. Fresh (1) is a shell herdr-core gave a terminal it keeps, in place of the program it lost, in the last
# <max age> seconds: the terminal was made well before its shell started, where a tab opened just now has a shell
# as new as its terminal. A tab whose shell ran the tmux client (`tma`) is back at its old shell instead.
idle_shells() {
  local layout=$1 max=$2 term space info pid machine age made fresh
  while IFS=$'\t' read -r term space; do
    info=$(hc get "$term" --json 2>/dev/null) || continue
    pid=$(jq -r 'select(.foreground.pid == .pid and (.foreground.argv[0] // "" | test("(^|/)-?(zsh|bash|fish|sh)$"))) | .pid' <<<"$info")
    [[ -n $pid ]] || continue
    machine="" fresh=0
    [[ $term == */* ]] && machine=${term%%/*}
    if [[ $(jq -r '.keep' <<<"$info") == true ]] && age=$(age_of "$machine" "$pid"); then
      made=$(jq -r '.created_ms // 0 | floor' <<<"$info")
      ((age <= max && made / 1000 < $(date +%s) - age - 60)) && fresh=1
    fi
    printf '%s\t%s\t%s\n' "$term" "$space" "$fresh"
  done < <(jq -r '.spaces[] | .id as $s | .tabs[].terminals[].terminal | [., $s] | @tsv' <<<"$layout")
}

# The session a tmux client with pid <pid> shows: "client|^|<its pane>|^|<session name>", then for each pane
# in the session "pane|^|<omo>|^|<pane>|^|<window index>|^|<window name>|^|<window active>|^|
# <pane active>|^|<program>|^|<folder>|^|<omo state>|^|<omo name>|^|<omo message>", <omo>
# being "omo" when omo runs on the pane's terminal (found as list-here finds it). Nothing
# when no client has that pid. It uses nothing else in this file but the tmux wrapper, so
# `where` can send it to a Herdr machine with declare -f.
where_here() {
  local pid=$1 session pane name panes line ttys=() omo=""
  IFS=$'\t' read -r session pane name < <(tmux list-clients -F $'#{client_pid}\t#{session_id}\t#{pane_id}\t#{s/~[0-9]+$//:session_name}' |
    awk -F'\t' -v p="$pid" '$1 == p { print $2 "\t" $3 "\t" $4; exit }')
  [[ -n $session ]] || return 0
  printf 'client|^|%s|^|%s\n' "$pane" "$name"
  panes=$(tmux list-panes -s -t "$session" -F '#{pane_tty}|^|#{pane_id}|^|#{window_index}|^|#{window_name}|^|#{window_active}|^|#{pane_active}|^|#{pane_current_command}|^|#{pane_current_path}|^|#{@omo_state}|^|#{@omo_name}|^|#{@omo_msg}')
  # Only the session's terminals: ps -A takes ten times as long, and the panels ask every few seconds.
  while IFS= read -r line; do
    line=${line%%"|^|"*}
    [[ -n $line ]] && ttys+=(-t "${line#/dev/}")
  done <<<"$panes"
  ((${#ttys[@]})) && omo=$(ps -o tty=,args= "${ttys[@]}" 2>/dev/null |
    awk '/\/senpi\/dist\/bundle\/cli\.js|\/omo-ai\/bin\/omo\.js/ { print "/dev/" $1 }' | sort -u)
  OMO_TTYS=$omo awk '
      BEGIN { n = split(ENVIRON["OMO_TTYS"], t, "\n"); for (i = 1; i <= n; i++) omo[t[i]] = 1 }
      { i = index($0, "|^|"); print "pane|^|" ((substr($0, 1, i - 1) in omo) ? "omo" : "") substr($0, i) }' <<<"$panes"
}

# The MCP servers the omo session in tmux pane $1 gets, worked out as omo does when it starts or
# reloads: the user mcp.json, then the project's Claude .mcp.json (only when importConfigs has
# "claude") and its .omo/mcp.json, both only in a trusted project (the nearest trust.json entry,
# else a linked worktree's main checkout's); omo's bundled context7 and grep_app unless configured
# by name. Each comes with its sign-in, its last tool list (mcp-cache.json), its latest problem
# in omo's log, and the session's own latest call to it since the config was read (from its
# transcript: whether it worked, and omo's error if not). omo keeps live connection state in its
# process, so a server not called since shows only what its config says. A pane that runs no omo
# stands for the first omo pane in its tmux session.
mcp_here() {
  local pane=$1 agent=$HOME/.omo/agent transcript="" state="" omo_pane=$1 header cwd loaded trust=n/a ok=true
  local common gitdir main mtime=0 f name dir auth issues calls from cache size seen scan start
  IFS=$'\t' read -r transcript state < <(tmux display-message -p -t "$pane" $'#{@omo_transcript}\t#{@omo_state}' 2>/dev/null)
  if [[ -z $transcript || -z $state ]]; then
    IFS=$'\t' read -r omo_pane transcript < <(tmux list-panes -s -t "$pane" -F $'#{pane_id}\t#{@omo_transcript}\t#{@omo_state}' 2>/dev/null |
      awk -F'\t' '$2 != "" && $3 != "" { print $1 "\t" $2; exit }')
  fi
  [[ -n $transcript && -r $transcript ]] || return 0
  header=$(head -n 1 "$transcript")
  cwd=$(jq -r '.cwd // empty' <<<"$header")
  [[ -n $cwd ]] || return 0
  # omo reads its MCP config when it starts and on /reload, and logs a pi-rules.scan entry each time.
  # What matters is the last one and the latest call per tool since. A transcript only grows, so
  # what was found last time is kept per transcript (omo-status/mcp) and only what was added since
  # is read: tens of MB once, then a few KB.
  cache="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/mcp/${transcript##*/}"
  size=$(($(wc -c <"$transcript")))
  { IFS=' ' read -r seen from loaded; IFS= read -r calls; } <"$cache" 2>/dev/null
  if [[ ! $seen =~ ^[0-9]+$ ]] || ((seen > size)); then seen=0 from=0 loaded="" calls='[]'; fi
  scan=$(tail -c +$((seen + 1)) "$transcript" | head -c $((size - seen)) | grep -a -b '"customType":"pi-rules.scan"' | tail -n 1 | cut -d: -f1)
  if [[ -n $scan ]]; then
    from=$((seen + scan)) calls='[]'
    loaded=$(tail -c +$((from + 1)) "$transcript" | head -n 1 | jq -r '.timestamp // empty' 2>/dev/null)
  fi
  start=$((from > seen ? from : seen))
  calls=$(tail -c +$((start + 1)) "$transcript" | head -c $((size - start)) | grep -a '"toolName":"mcp_' |
    jq -c 'select(.message.role? == "toolResult") | {at: .timestamp, tool: .message.toolName,
      error: (.message.details.error.message // (if .message.isError then (((.message.content // [])[0].text // "failed")[0:200]) else null end))}' 2>/dev/null |
    jq -s -c --argjson old "${calls:-[]}" '$old + . | group_by(.tool) | map(max_by(.at)) | sort_by(.at)')
  # Kept only when the read ended on a whole line: a line omo was still writing is read again next time.
  if [[ -z $(tail -c +$((size > 0 ? size : 1)) "$transcript" | head -c 1 | tr -d '\n') ]]; then
    mkdir -p "${cache%/*}" && printf '%s %s %s\n%s\n' "$size" "$from" "$loaded" "$calls" >"$cache"
  fi
  [[ -n $loaded ]] || loaded=$(jq -r '.timestamp // empty' <<<"$header")
  # Trust only matters when the project has something under .omo that needs it.
  for f in settings.json mcp.json extensions skills prompts themes SYSTEM.md APPEND_SYSTEM.md; do
    [[ -e $cwd/.omo/$f ]] && trust=ask
  done
  if [[ $trust == ask ]]; then
    local near='def near($p): if has($p) then .[$p] elif ($p == "/" or $p == "") then null else near($p | sub("/[^/]+$"; "") | if . == "" then "/" else . end) end; near($p) // "none"'
    trust=$(jq -r --arg p "$cwd" "$near" "$agent/trust.json" 2>/dev/null)
    if [[ $trust == none ]]; then
      common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
      gitdir=$(git -C "$cwd" rev-parse --path-format=absolute --git-dir 2>/dev/null)
      main=${common%/.git}
      [[ -n $common && $common != "$gitdir" ]] && trust=$(jq -r --arg p "$main" "$near" "$agent/trust.json" 2>/dev/null)
    fi
    case $trust in true) trust=yes ;; false) trust=no ok=false ;; *) trust=ask ok=false ;; esac
  fi
  for f in "$agent/mcp.json" "$cwd/.mcp.json" "$cwd/.omo/mcp.json"; do
    [[ -f $f ]] && (($(date -r "$f" +%s) > mtime)) && mtime=$(date -r "$f" +%s)
  done
  # Sign-ins: only when they expire and whether they can refresh. The tokens never leave jq.
  auth=$(jq -r 'to_entries[] | "\(.key)\t\(.value)"' "$agent/mcp-auth/index.json" 2>/dev/null |
    while IFS=$'\t' read -r name dir; do
      jq -c --arg n "$name" '{($n): {expiresAt: (.expiresAt // 0), refresh: (.refreshToken != null)}}' "$agent/mcp-auth/$dir/tokens.json" 2>/dev/null
    done | jq -s 'add // {}')
  # Each server's latest logged problem, from the end of every log in one tail and one jq (/dev/null
  # makes tail head every file with its name, even when there is only one).
  issues=$(tail -n 40 /dev/null "$agent"/logs/mcp/*.log 2>/dev/null |
    awk '/^==> .* <==$/ { n = $0; sub(/^==> /, "", n); sub(/ <==$/, "", n); sub(/.*\//, "", n); sub(/\.log$/, "", n); next } NF { print n "\t" $0 }' |
    jq -R -s -c '[split("\n")[] | select(length > 0) | index("\t") as $i | {n: .[:$i], e: (.[$i + 1:] | fromjson? // empty)}
      | select(.e.level == "warning" or .e.level == "error") | select(.e.message | test("exposed tools after|negotiated") | not)
      | {key: .n, value: {at: .e.timestamp, message: .e.message[0:200]}}] | from_entries')
  jq -n --argjson header "$header" --arg pane "$pane" --arg omo "$omo_pane" --arg cwd "$cwd" --arg loaded "$loaded" \
    --arg trust "$trust" --argjson ok "$ok" --argjson mtime "$mtime" --argjson now "$(($(date +%s) * 1000))" \
    --arg target "$(tmux display-message -p -t "$omo_pane" '#{s/~[0-9]+$//:session_name}:#{window_index}.#{pane_index}' 2>/dev/null)" \
    --argjson g "$(jq -c . "$agent/mcp.json" 2>/dev/null || echo null)" \
    --argjson c "$(jq -c . "$cwd/.mcp.json" 2>/dev/null || echo null)" \
    --argjson p "$(jq -c . "$cwd/.omo/mcp.json" 2>/dev/null || echo null)" \
    --argjson cache "$(jq -c '.servers // {}' "$agent/cache/mcp-cache.json" 2>/dev/null || echo '{}')" \
    --argjson auth "${auth:-{\}}" --argjson issues "${issues:-{\}}" --argjson calls "${calls:-[]}" '
    def secs: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
    ([$g.settings.importConfigs, (if $ok then $p.settings.importConfigs else null end)] | map(. // []) | add | index("claude") != null) as $import
    | [{src: "user", cfg: $g, use: true}, {src: "claude", cfg: $c, use: ($ok and $import)}, {src: "project", cfg: $p, use: $ok}] as $srcs
    | (reduce ($srcs[] | select(.use and .cfg != null) | .src as $s | (.cfg.mcpServers // {}) | to_entries[] | {key, value: {source: $s, def: .value}}) as $e
        ({}; .[$e.key] = $e.value)) as $chosen
    | (reduce ({context7: "https://mcp.context7.com/mcp", grep_app: "https://mcp.grep.app"} | to_entries[]) as $b
        ($chosen; if has($b.key) then . else .[$b.key] = {source: "omo", def: {type: "http", url: $b.value}} end)) as $all
    | {shown: $pane, pane: $omo, target: $target, session: $header.id, cwd: $cwd, loadedAt: $loaded, trust: $trust,
       configChanged: ($loaded != "" and $mtime > ($loaded | secs)),
       blocked: (if $ok or $p == null then [] else ($p.mcpServers // {} | keys) end),
       notImported: (if $c != null and ($ok and $import | not) then ($c.mcpServers // {} | keys) else [] end),
       servers: ([$all | to_entries[] | .key as $n | .value.def as $d | {
         name: $n, source: .value.source,
         kind: ($d.type // (if $d.url then "http" else "stdio" end)),
         enabled: ($d.enabled != false),
         where: (if $d.url then ($d.url | sub("^https?://"; "") | sub("[?#].*$"; "")) else (($d.command // "") | split("/") | last) end),
         tools: ($cache[$n].tools | if . == null then null else length end),
         fetchedAt: $cache[$n].fetchedAt,
         auth: (if $d.url == null then "none"
                elif $auth[$n] then (if $auth[$n].expiresAt > $now or $auth[$n].refresh then "signed in" else "expired" end)
                elif $d.auth == "oauth" or (($issues[$n].message // "") | test("Unauthorized|401")) then "needs sign-in"
                else "none" end),
         issue: ($issues[$n] | if . != null and (.at | secs) > ($now / 1000 - 86400) then . else null end),
         lastCall: ([$calls[] | select(.tool | startswith("mcp_\($n)_")) | select($loaded == "" or (.at | secs) >= ($loaded | secs))] | last
           | if . then {at, tool: (.tool | ltrimstr("mcp_\($n)_")), ok: (.error == null), error} else null end)
       }] | sort_by(.name))}'
}

# Herdr machines herdr-core is connected to. Only where the Herdr app runs: on a
# machine itself this finds none, so it never reaches further.
machines() {
  command -v herdr-app >/dev/null && command -v hc >/dev/null || return 0
  hc machine ls --json 2>/dev/null | jq -r '.machines[] | select(.state == "connected" and (.temporary | not)) | .name'
}

# This script with these arguments, here, or on Herdr machine <machine> when one is named.
at() {
  local machine=$1
  shift
  if [[ -z $machine ]]; then
    "$0" "$@"
  else
    hc exec --on "$machine" --timeout 5 sh -c 'exec "$HOME/.local/bin/omo-status" "$@"' omo-status "$@"
  fi
}

# Run on another machine by `follow`, through `hc exec --on`, in plain sh: waits until that machine's
# list tick has a time other than the one it is given ($1), looking every quarter second, then prints
# "change <time>"; after 15 s with no change, "beat <time>". hc passes output on only once a command
# ends, so `follow` holds one wait open at a time rather than a stream.
# The time is "<list tick>|<tabs tick>": the tabs tick is touched by that machine's tab mode hooks (tabs_request).
follow_wait='
tick="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/list/tick"
tabs="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/tabs/tick"
stamp() { stat -c %y "$1" 2>/dev/null || stat -f %Fm "$1" 2>/dev/null || echo none; }
both() { echo "$(stamp "$tick")|$(stamp "$tabs")"; }
i=0 now=$(both)
while [ "$now" = "$1" ] && [ $i -lt 60 ]; do sleep 0.25; i=$((i + 1)); now=$(both); done
if [ "$now" = "$1" ]; then echo "beat $now"; else echo "change $now"; fi'

# `follow` for one machine: asks it to wait for its next change, touches remote_dir's tick at each answer
# (a change, or the beat that shows the link is up), and asks again. A machine that doesn't answer is asked
# again after 2 s, backing off to every 30 s, until it is no longer connected. When the machine's tabs tick moved, its
# tab mode hooks noted sessions whose Herdr tabs need setting right, which tabs-pending does here.
follow_machine() {
  local machine=$1 stamp="" reply pause=2 up=1 tabs=""
  while :; do
    if reply=$(hc exec --on "$machine" --timeout 30 sh -c "$follow_wait" follow "$stamp" 2>/dev/null) &&
      [[ $reply == "change "* || $reply == "beat "* ]]; then
      stamp=${reply#* } pause=2
      if [[ $stamp == *"|"* && ${stamp##*|} != "$tabs" ]]; then
        tabs=${stamp##*|}
        "$0" tabs-pending "$machine" >/dev/null 2>&1 &
      fi
      [[ -n $up ]] || echo "$(date '+%F %T') $machine answers again"
      up=1
      touch "$remote_dir/tick"
    else
      [[ -z $up ]] || echo "$(date '+%F %T') $machine didn't answer; asking again, at most every 30 s"
      up=""
      sleep "$pause"
      ((pause = pause < 16 ? pause * 2 : 30))
      [[ $'\n'$(machines)$'\n' == *$'\n'"$machine"$'\n'* ]] || return 0
    fi
  done
}

# A machine's rows, its name in front of the pane and the session ("server/%3").
prefixed() {
  local machine=$1 line
  while IFS= read -r line; do
    [[ -n $line ]] && printf '%s/%s\n' "$machine" "${line/"|^|"/"|^|$machine/"}"
  done
}

# A tab attached to a tmux session, in its saved Herdr space, else the space named
# after it, else a new space for it in <folder>, on <machine> when the session lives
# on one. A terminal already on the session is shown instead of opening a second
# one. A space this makes goes in $spaces_file.
# One opening at a time, and each waits for its tmux client to attach before the next one looks:
# two at once (a double click, or Telegram's button and a click) each found no client and both
# opened a space for the session (prawnwire, 2026-11-11). A lock a killed run left is ignored
# after 10 s. spaces holds its own lock around its calls, so this one is separate.
open_space() {
  local lock="${spaces_file%/*}/open.lock" tries=0 rc
  mkdir -p "${spaces_file%/*}"
  while ! mkdir "$lock" 2>/dev/null && ((tries++ < 100)); do sleep 0.1; done
  open_space_now "$@"
  rc=$?
  rmdir "$lock" 2>/dev/null
  return "$rc"
}

# Until Herdr shows a tmux client on session <key> ("<machine>/<session>" off this Mac), at most 5 s.
wait_attached() {
  local end=$((SECONDS + 5))
  while ((SECONDS < end)); do
    herdr_attached "$(herdr-app ls 2>/dev/null)" 2>/dev/null | cut -f1 | grep -qxF -- "$1" && return 0
    sleep 0.2
  done
  return 0
}

# The Herdr space of tmux session <key> ("<machine>/<session>" off this Mac) in Herdr's layout <layout>: the
# one saved for it in $spaces_file (a saved id survives a rename of the space), else the one named after it.
space_of() {
  local key=$1 layout=$2 machine="" session=${1#*/} saved id
  [[ $key == */* ]] && machine=${key%%/*}
  if [[ -f $spaces_file ]]; then
    while IFS=$'\t' read -r saved id; do
      if [[ $saved == "$key" ]] && jq -e --arg id "$id" 'any(.spaces[]; .id == $id)' <<<"$layout" >/dev/null; then
        printf '%s\n' "$id"
        return
      fi
    done <"$spaces_file"
  fi
  jq -r --arg n "$session" --arg m "$machine" \
    'first(.spaces[] | select(.name == $n and (.machine // "") == $m) | .id) // empty' <<<"$layout"
}

# <argv>: what the tab runs for a session that doesn't exist yet (it makes it), else it attaches to <target>.
open_space_now() {
  local session=$1 folder=$2 target=$3 machine=${4:-} key=${4:+$4/}$1 argv=${5:-} space made layout terminal
  layout=$(herdr-app ls 2>/dev/null)
  if [[ -z $argv ]]; then
    # Tab mode: a tab for each window, the target's shown (tabs_sync_now fails with 3 for a session not in tab mode).
    tabs_sync_now "$key" --all "$target"
    (($? == 3)) || return 0
    layout=$(herdr-app ls 2>/dev/null)
    terminal=$(herdr_attached "$layout" | awk -F'\t' -v key="$key" '$1 == key { print $2; exit }')
    if [[ -n $terminal ]]; then
      herdr-app "do" pane.focus --terminal "$terminal" >/dev/null
      return
    fi
    argv=$(jq -cn --arg t "$target" '["tmux", "attach-session", "-t", $t]')
  fi
  space=$(space_of "$key" "$layout")
  if [[ -n $space ]]; then
    herdr-app "do" tab.new --space "$space" --name "$session" --argv "$argv" >/dev/null
    wait_attached "$key"
    return
  fi
  made=$(herdr-app "do" space.new --name "$session" --folder "$folder" ${machine:+--machine "$machine"} --argv "$argv") || return 1
  space=$(jq -r '.space // empty' <<<"$made")
  [[ -n $space ]] || return 1
  mkdir -p "$(dirname "$spaces_file")"
  printf '%s\t%s\n' "${machine:+$machine/}$session" "$space" >>"$spaces_file"
  wait_attached "$key"
}

# Tab mode: "<name>~<window id>" for window <window> of this computer's session <name> (id <bid>): a session
# sharing <name>'s windows that shows that window, made when there is none, and its name printed. Its tab's
# client sets destroy-unattached as it attaches (tmux ends an unattached session that has it at once), so
# closing the tab ends the session. @omo_herdr: only Herdr shows it, so omo-notify leaves sounds to Herdr.
tab_session() {
  local name=$1 bid=$2 window=$3 tname=$1~${3#@}
  tmux has-session -t "=$tname" 2>/dev/null ||
    tmux new-session -d -s "$tname" -t "$bid" \; set-option -t "=$tname:" @herdr_base "$bid" \
      \; set-option -t "=$tname:" @omo_herdr 1 || return 1
  tmux select-window -t "=$tname:$window" || return 1
  printf '%s\n' "$tname"
}

# What a Herdr tab on tab session <tname> runs.
tab_argv() {
  jq -cn --arg t "=$1" '["tmux", "attach-session", "-t", $t, ";", "set-option", "destroy-unattached", "on"]'
}

# Whether tmux session <tname> is a tab of session <name>.
tab_of() {
  [[ $1 == "$2~"* && ${1##*~} =~ ^[0-9]+$ ]]
}

# The label of a window's tab: label_of its first pane running omo (else its first pane), else its name.
window_label() {
  local window name task path label
  IFS=$'\x1f' read -r window name task path < <(tmux list-panes -t "$1" \
    -F $'#{@omo_state}\x1f#{window_name}\x1f#{@omo_name}\x1f#{@omo_task}\x1f#{pane_current_path}' |
    awk -F$'\x1f' 'NR == 1 { first = $0 } $1 != "" { print substr($0, index($0, "\x1f") + 1); found = 1; exit }
      END { if (!found) print substr(first, index(first, "\x1f") + 1) }')
  label=$(label_of "$window" "$name" "$task" "$path")
  printf '%s' "${label:-$window}"
}

# Puts this computer's tmux session <name> (--all: every session, those made later too) in tab mode (on) or out of it
# (off), in $tab_sessions_file. With every session in tab mode, off leaves the one out.
tab_mode_set() {
  local name=$1 mode=$2 lines
  mkdir -p "${tab_sessions_file%/*}"
  if [[ $name == --all ]]; then
    if [[ $mode == on ]]; then printf '*\n' >"$tab_sessions_file"; else rm -f "$tab_sessions_file"; fi
    return 0
  fi
  if [[ $mode == on ]]; then
    lines=$(grep -vxF -e "-$name" "$tab_sessions_file" 2>/dev/null)
    grep -qxF -e "$name" -e '*' <<<"$lines" || lines+=$'\n'"$name"
  else
    lines=$(grep -vxF -e "$name" "$tab_sessions_file" 2>/dev/null)
    grep -qxF '*' <<<"$lines" && lines+=$'\n'"-$name"
  fi
  sed '/^$/d' <<<"$lines" >"$tab_sessions_file"
}

# The terminals of the tabs on tab session <tid>, as "<first field>\t<terminal>" lines.
tab_clients() {
  local pid term
  for pid in $(tmux list-clients -t "$1" -F '#{client_pid}' 2>/dev/null); do
    term=$(herdr_terminal "$pid")
    [[ -n $term ]] && printf '%s\t%s\n' "$2" "$term"
  done
}

# Tab mode's tmux side for session <name>, run where the session lives (tabs_at): sets its tab sessions right and
# prints what Herdr must do, a tab-separated line each: "off" (not in tab mode), "have <window> <terminal>" for each
# tab (no terminal while its client is still attaching), "close <terminal>", "rename <terminal> <label>", "folder <path>", "open <window> <tab session>
# <label>", "order <window ids>" and "show <window>". <show> may be a pane, whose window is shown. See tabs_sync.
tabs_here() {
  local name=$1 all=${2:-} show=${3:-} bid folder seen windows now tname tid tcur tclients tcreated twin tabs=$'\n'
  local pid tty cur term wid label ids
  if ! tab_mode "$name"; then
    echo off
    return 0
  fi
  IFS=$'\t' read -r bid folder seen < <(tmux display-message -p -t "=$name:" $'#{session_id}\t#{session_path}\t#{@herdr_tab_seen}' 2>/dev/null)
  [[ -n $bid ]] || return 0
  [[ $show == %* ]] && show=$(tmux display-message -p -t "$show" '#{window_id}' 2>/dev/null)
  [[ $show == @* ]] || show=""
  windows=$(tmux list-windows -t "$bid" -F '#{window_id}')
  now=$(date +%s)
  while IFS=$'\t' read -r tname tid tcur tclients tcreated; do
    tab_of "$tname" "$name" || continue
    twin=@${tname##*~}
    if [[ $'\n'$windows$'\n' != *$'\n'"$twin"$'\n'* ]]; then
      # Its window has gone. herdr-core gives a tab whose client ends a shell, so the tab is closed too.
      tab_clients "$tid" close
      tmux kill-session -t "$tid"
    elif ((tclients == 0)); then
      # Not attached: its tab is opening right now, else nothing will attach to it.
      if ((now - tcreated > 15)); then
        tmux kill-session -t "$tid"
      else
        printf 'have\t%s\t\n' "$twin"
        tabs+="$twin"$'\n'
      fi
    else
      if [[ $tcur != "$twin" ]]; then
        tmux select-window -t "$tid:$twin"
        [[ -n $show ]] || show=$tcur
      fi
      tab_clients "$tid" "have"$'\t'"$twin"
      tabs+="$twin"$'\n'
    fi
  done < <(tmux list-sessions -F $'#{session_name}\t#{session_id}\t#{window_id}\t#{session_attached}\t#{session_created}')
  # A Herdr tab on the session itself becomes the tab of the window it shows; a second tab on that window closes.
  while read -r pid tty cur; do
    term=$(herdr_terminal "$pid")
    [[ -n $term ]] || continue
    if [[ $tabs == *$'\n'"$cur"$'\n'* ]]; then
      printf 'close\t%s\n' "$term"
      continue
    fi
    tname=$(tab_session "$name" "$bid" "$cur") || continue
    label=$(window_label "$cur")
    tmux switch-client -c "$tty" -t "=$tname" \; set-option -t "=$tname:" destroy-unattached on \
      \; set-option -t "=$tname:" @omo_label "$label"
    printf 'rename\t%s\t%s\nhave\t%s\t%s\n' "$term" "$label" "$cur" "$term"
    tabs+="$cur"$'\n'
  done < <(tmux list-clients -t "$bid" -F '#{client_pid} #{client_tty} #{window_id}')
  # Only a session Herdr shows is kept: one it doesn't is opened by open_space, show or `tabs`, not by a new window.
  [[ -n $all || -n $show || $tabs != $'\n' ]] || return 0
  printf 'folder\t%s\n' "$folder"
  while IFS= read -r wid; do
    [[ -n $wid && $tabs != *$'\n'"$wid"$'\n'* ]] || continue
    [[ -n $all || $wid == "$show" || ",$seen," != *",$wid,"* ]] || continue
    tname=$(tab_session "$name" "$bid" "$wid") || continue
    label=$(window_label "$wid")
    tmux set-option -t "=$tname:" @omo_label "$label"
    printf 'open\t%s\t%s\t%s\n' "$wid" "$tname" "$label"
  done <<<"$windows"
  ids=$(paste -sd, - <<<"$windows")
  [[ $ids == "$seen" ]] || tmux set-option -t "$bid" @herdr_tab_seen "$ids"
  printf 'order\t%s\n' "$(paste -sd' ' - <<<"$windows")"
  [[ -n $show ]] && printf 'show\t%s\n' "$show"
  return 0
}

# Tab mode's tmux side of going back to one tab for session <name>: the tab whose terminal is one of <focused> (else
# the first) goes back on the session itself, and every tab's session ends. Prints "rename <terminal> <name>" for the
# tab kept and "close <terminal>" for the others. tmux's client-session-changed hook then reports to the tab kept.
tabs_off_here() {
  local name=$1 focused=$'\n'$2$'\n' bid keep="" kterm="" index pid tty tname tid term
  bid=$(tmux display-message -p -t "=$name:" '#{session_id}' 2>/dev/null) || return 0
  while read -r index pid tty tname; do
    tab_of "$tname" "$name" || continue
    term=$(herdr_terminal "$pid")
    [[ -n $term ]] || continue
    if [[ -z $keep || $focused == *$'\n'"$term"$'\n'* ]]; then keep=$tty kterm=$term; fi
    [[ $focused == *$'\n'"$term"$'\n'* ]] && break
  done < <(tmux list-clients -F '#{window_index} #{client_pid} #{client_tty} #{session_name}' | sort -n)
  tmux set-option -u -t "$bid" @herdr_tab_seen
  if [[ -n $keep ]]; then
    tmux switch-client -c "$keep" -t "$bid" \; set-option -t "$bid" @omo_label "$name"
    printf 'rename\t%s\t%s\n' "$kterm" "$name"
  fi
  while read -r tname tid; do
    tab_of "$tname" "$name" || continue
    tab_clients "$tid" close
    tmux kill-session -t "$tid"
  done < <(tmux list-sessions -F '#{session_name} #{session_id}')
  return 0
}

# A tab mode function (tabs_here, tabs_off_here, tab_mode, tab_mode_set, tab_sessions, tmux) with its arguments, here,
# or on Herdr machine <machine> with what it needs sent along (that machine's omo-status may be older).
tabs_at() {
  local machine=$1
  shift
  if [[ -z $machine ]]; then
    "$@"
    return
  fi
  hc exec --on "$machine" --timeout 20 bash -c "$(declare -f tmux herdr_terminal label_of tab_mode tab_sessions tab_mode_set \
    tab_of tab_session window_label tab_clients tabs_here tabs_off_here)"'
    tab_sessions_file="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/tab-sessions"
    real_sessions="#{?#{m:*~[0-9]*,#{session_name}},0,1}"
    "$@"' tabs "$@"
}

# Names the Herdr tab that shows terminal <terminal>.
rename_tab() {
  local tab
  tab=$(herdr-app ls 2>/dev/null | jq -r --arg t "$1" 'first(.spaces[].tabs[] | select(any(.terminals[]; .terminal == $t)) | .id) // empty')
  [[ -n $tab ]] && herdr-app "do" tab.rename --id "$tab" --name "$2" >/dev/null 2>&1
}

# Closes the Herdr tab that shows terminal <terminal>, ending its program.
close_tab() {
  local tab
  tab=$(herdr-app ls 2>/dev/null | jq -r --arg t "$1" 'first(.spaces[].tabs[] | select(any(.terminals[]; .terminal == $t)) | .id) // empty')
  [[ -n $tab ]] && herdr-app "do" tab.close --id "$tab" --confirmed true >/dev/null 2>&1
}

# The Herdr terminal of the tab on window <window> of tab mode session <name>, waiting up to <wait> seconds for its
# client to attach. Nothing when there is none.
tab_terminal() {
  local name=$1 window=$2 end=$((SECONDS + ${3:-0})) pid term
  while :; do
    for pid in $(tmux list-clients -t "=$name~${window#@}" -F '#{client_pid}' 2>/dev/null); do
      term=$(herdr_terminal "$pid")
      [[ -n $term ]] && printf '%s\n' "$term" && return 0
    done
    ((SECONDS < end)) || return 1
    sleep 0.2
  done
}

# A computer without the Herdr app (a Herdr machine) can't open or close tabs: its tab mode hooks note the session
# for the Mac, whose follow agent hears of it at once (the tabs tick, see follow_wait) and runs tabs-sync there.
tabs_request() {
  mkdir -p "${tabs_tick%/*}"
  printf '%s\n' "$1" >>"${tabs_tick%/*}/pending"
  touch "$tabs_tick"
}

# Tab mode's Herdr tabs for tmux session <key> ("<machine>/<session>" for one on a Herdr machine): a tab per window,
# in the session's space (made when there is none), in window order. tabs_here sets the tmux side right where the
# session lives and says what to do here: a tab whose window has gone closes and its session ends; a tab moved to
# another window (prefix n, or a window made in it) goes back, and the tab of the window it went to is shown; a Herdr
# tab on the session itself becomes the tab of the window it shows; a tab's session no client attached to goes
# (tmux-resurrect brings them back). A window gets its tab once: a tab you close stays closed until you show its pane,
# or until this runs with --all (<all>). <show>, a window id or a pane, is shown at the end. Fails with 3 when the
# session isn't in tab mode. One run per session at a time.
tabs_sync() {
  local lock="${spaces_file%/*}/tabs-${1//\//_}.lock" tries=0 rc
  if ! command -v herdr-app >/dev/null; then
    tabs_request "$1"
    return 0
  fi
  mkdir -p "${spaces_file%/*}"
  while ! mkdir "$lock" 2>/dev/null && ((tries++ < 100)); do sleep 0.1; done
  tabs_sync_now "$@"
  rc=$?
  rmdir "$lock" 2>/dev/null
  return "$rc"
}

tabs_sync_now() {
  local key=$1 all=${2:-} show=${3:-} machine="" name=$1 prefix="" plan kind a b c layout space folder="" made
  local map=$'\n' order="" opened=0 index=1 window term tab line
  [[ $key == */* ]] && machine=${key%%/*} name=${key#*/} prefix=$machine/
  plan=$(tabs_at "$machine" tabs_here "$name" "$all" "$show") || return 0
  [[ $plan == off ]] && return 3
  [[ -n $plan ]] || return 0
  layout=$(herdr-app ls 2>/dev/null) || return 0
  space=$(space_of "$key" "$layout")
  show=""
  while IFS=$'\t' read -r kind a b c; do
    case $kind in
      have) map+="$a ${b:+$prefix$b}"$'\n' ;;
      close) close_tab "$prefix$a" ;;
      rename)
        rename_tab "$prefix$a" "$b"
        opened=$((opened + 1))
        ;;
      folder) folder=$a ;;
      open)
        if [[ -n $space ]]; then
          made=$(herdr-app "do" tab.new --space "$space" --name "$c" --argv "$(tab_argv "$b")" --focus false) || continue
        else
          made=$(herdr-app "do" space.new --name "$name" --folder "$folder" ${machine:+--machine "$machine"} --tab "$c" \
            --argv "$(tab_argv "$b")" --focus false) || continue
          space=$(jq -r '.space // empty' <<<"$made")
          [[ -n $space ]] && printf '%s\t%s\n' "$key" "$space" >>"$spaces_file"
        fi
        term=$(jq -r '.terminal // empty' <<<"$made")
        [[ -z $term || -z $machine || $term == */* ]] || term=$prefix$term
        [[ -n $term ]] && map+="$a $term"$'\n'
        opened=$((opened + 1))
        ;;
      order) order=$a ;;
      show) show=$a ;;
    esac
  done <<<"$plan"
  # In window order. tab.move counts from 1; a tab still attaching keeps its place but counts; tabs that aren't the
  # session's stay after its own.
  if ((opened)) && [[ -n $space ]]; then
    layout=$(herdr-app ls 2>/dev/null)
    for window in $order; do
      line=$(awk -v w="$window" '$1 == w { print; exit }' <<<"$map")
      [[ -n $line ]] || continue
      term=${line#* }
      if [[ -n $term ]]; then
        tab=$(jq -r --arg s "$space" --arg t "$term" \
          'first(.spaces[] | select(.id == $s) | .tabs[] | select(any(.terminals[]; .terminal == $t)) | .id) // empty' <<<"$layout")
        [[ -n $tab ]] && herdr-app "do" tab.move --id "$tab" --index "$index" >/dev/null 2>&1
      fi
      index=$((index + 1))
    done
  fi
  if [[ -n $show ]]; then
    term=$(awk -v w="$show" '$1 == w { print $2; exit }' <<<"$map")
    [[ -n $term ]] && herdr-app "do" pane.focus --terminal "$term" >/dev/null
  fi
  return 0
}

# Ends tab mode's tabs for tmux session <key> ("<machine>/<session>" on a Herdr machine): the tab you are on (else the
# first) goes back on the session itself and is named after it; the other tabs close and their sessions end.
tabs_off() {
  local key=$1 machine="" name=$1 prefix="" focused plan kind a b
  [[ $key == */* ]] && machine=${key%%/*} name=${key#*/} prefix=$machine/
  # The terminals of the tab Herdr has focused, as that machine names them.
  focused=$(herdr-app ls 2>/dev/null | jq -r --arg t "$(herdr-app status 2>/dev/null | jq -r '.tab // empty')" \
    '.spaces[].tabs[] | select(.id == $t) | .terminals[].terminal')
  if [[ -n $machine ]]; then focused=$(sed -n "s|^$machine/||p" <<<"$focused"); else focused=$(grep -v / <<<"$focused"); fi
  plan=$(tabs_at "$machine" tabs_off_here "$name" "$focused")
  while IFS=$'\t' read -r kind a b; do
    case $kind in
      rename) rename_tab "$prefix$a" "$b" ;;
      close) close_tab "$prefix$a" ;;
    esac
  done <<<"$plan"
  return 0
}

forget() {
  tmux set-option -p -u -t "$1" @omo_state \; set-option -p -u -t "$1" @omo_msg \; set-option -p -u -t "$1" @omo_task \
    \; set-option -p -u -t "$1" @omo_since \; set-option -p -u -t "$1" @omo_name \; set-option -p -u -t "$1" @omo_resume \
    \; set-option -p -u -t "$1" @omo_goal \; set-option -p -u -t "$1" @omo_goal_mins
  rm -f "$seen_dir/${1#%}"
}

# What a tab or Herdr's agents list calls a window's work: the window's name when it names the work (an
# owt title), else omo's name for the session, else the task (the last prompt's first line), else the folder.
label_of() {
  local window=$1 name=$2 task=$3 path=$4 label
  case $window in
    # tmux: what tmux calls a new window until its program has started.
    bun | node | omo | zsh | bash | fish | sh | tmux) label=${name:-${task:-${path##*/}}} ;;
    mosh-client | ssh) label="" ;; # a server's session: its work is named there
    *) label=$window ;;
  esac
  ((${#label} > 40)) && label="${label:0:39}…"
  printf '%s' "$label"
}

# The session a tab mode tab's session stands for (its @herdr_base), else the session itself, as an id. Takes
# any target: the session tmux picks for a pane is often a tab's, since tabs hold the clients in use.
base_session() {
  tmux display-message -p -t "$1" '#{?@herdr_base,#{@herdr_base},#{session_id}}' 2>/dev/null
}

# Whether this computer's tmux session <name> is in tab mode: named in $tab_sessions_file, or every session is (a
# "*" line) and it isn't left out (a "-<name>" line).
tab_mode() {
  [[ -f $tab_sessions_file ]] || return 1
  grep -qxF -e "-$1" "$tab_sessions_file" && return 1
  grep -qxF -e "$1" -e '*' "$tab_sessions_file"
}

# This computer's tmux sessions in tab mode, one name per line.
tab_sessions() {
  local name
  while IFS= read -r name; do
    tab_mode "$name" && printf '%s\n' "$name"
  done < <(tmux list-sessions -f "$real_sessions" -F '#{session_name}' 2>/dev/null)
}

# show_most_urgent's pane rows, one per pane, fields split by \x1f, the window's id last.
pane_rows_format=$'#{pane_id}\x1f#{pane_current_command}\x1f#{@omo_state}\x1f#{@omo_msg}\x1f#{pane_current_path}\x1f#{window_name}\x1f#{@omo_task}\x1f#{@omo_name}\x1f#{@omo_resume}\x1f#{@omo_since}\x1f#{window_id}'

# The most urgent of some pane rows (pane_rows_format), as Herdr gets it: sets best (the state), best_msg and
# label, and omo_panes to the panes running omo ("%1,%4,"), for the caller to declare. With <forget> (1) a pane
# back at its shell prompt no longer runs omo, so its state goes; only the session's own pass does that.
summarize() {
  local rows=$1 forget_shells=${2:-} pane cmd state msg path window task name resume urgent needing=0
  local best_raw="" best_project="" best_resume="" what="" prefix="" rest agent left
  best="" best_msg="" label="" omo_panes=""
  urgent=$(awk -F$'\x1f' '$2 ~ /^-?(zsh|bash|fish|sh|dash)$/ { next }
    { r = $3 == "error" ? 3 : $3 == "input" ? 2 : ($3 == "done" || $3 == "partial") ? 1 : 0; s = $10 + 0 }
    r > 0 && (r > br || (r == br && s < bs)) { br = r; bs = s; bp = $1 }
    END { print bp }' <<<"$rows")
  while IFS=$'\x1f' read -r pane cmd state msg path window task name resume _; do
    [[ -n $state ]] || continue
    case $cmd in
      zsh | bash | fish | sh | dash | -zsh | -bash)
        [[ -n $forget_shells ]] && forget "$pane"
        continue
        ;;
    esac
    omo_panes+="$pane,"
    case $state in input | error | done | partial) needing=$((needing + 1)) ;; esac
    if (($(rank "$state") > $(rank "$best"))) || [[ $pane == "$urgent" ]]; then
      best=$state best_msg=${msg:+${path##*/}: $msg} best_raw=$msg best_project=${path##*/} best_resume=$resume
      [[ $state == background ]] && best_msg=$msg
      label=$(label_of "$window" "$name" "$task" "$path")
    fi
  done <<<"$rows"
  # Herdr's agents list names the pane a click lands on and how many more wait behind it.
  case $best in
    input) what="needs you" prefix="Needs your input: " ;;
    error) what="failed" prefix="Failed: " ;;
    done) what="finished" prefix="Finished: " ;;
    partial) what="step done" prefix="Step done · " ;;
  esac
  if [[ -n $what ]]; then
    agent=${label:-$best_project} rest=${best_raw#"$prefix"}
    # The label is often the task itself, which needs saying only once.
    if [[ $agent == "$rest" || ($agent == *… && $rest == "${agent%…}"*) ]]; then best_msg="$what · $rest"; else best_msg="$what · $agent: $rest"; fi
    ((needing > 1)) && best_msg+=" (+$((needing - 1)) more)"
  fi
  # Herdr's list can't count down, so a goal's wait is given in minutes and changes once a minute.
  if [[ $best == background && -n $best_resume && $best_raw =~ ^goal\ (continues|retries|resumes)(.*)$ ]]; then
    best_msg="goal ${BASH_REMATCH[1]} in" rest=${BASH_REMATCH[2]} left=$((best_resume - $(date +%s)))
    if ((left < 60)); then best_msg+=" <1m"; elif ((left < 3600)); then best_msg+=" $((left / 60))m"; else best_msg+=" $((left / 3600))h $((left % 3600 / 60))m"; fi
    best_msg+=$rest
  fi
  return 0
}

# Tab mode: the client of each tab on session <session> (an id, named <name>) gets the state of the window it
# shows, from <rows> (pane_rows_format), and its tab that window's label. Each tab's session keeps what it was
# last sent. Fails when no Herdr tab shows a window of the session.
report_tabs() {
  local session=$1 name=$2 rows=$3 pid tty tsession tsid twin tlast tlabel term body sets found=1
  local best best_msg label omo_panes
  while IFS=$'\t' read -r pid tty tsession tsid twin tlast tlabel; do
    tab_of "$tsession" "$name" || continue
    term=$(herdr_terminal "$pid")
    [[ -n $term ]] || continue
    found=0
    summarize "$(awk -F$'\x1f' -v w="$twin" '$11 == w' <<<"$rows")"
    body=$(report_body "$best" "$best_msg" "$label")
    sets=()
    if [[ $body != "$tlast" ]]; then
      send_report "$tty" "$body"
      sets+=(';' set-option -t "$tsid" @omo_report "$body")
    fi
    if [[ -n $label && $label != "$tlabel" ]]; then
      sets+=(';' set-option -t "$tsid" @omo_label "$label")
      label_tabs "$label" "$tlabel" "$term" &
    fi
    if ((${#sets[@]})); then tmux "${sets[@]:1}"; fi
  done < <(tmux list-clients -F $'#{client_pid}\t#{client_tty}\t#{session_name}\t#{session_id}\t#{window_id}\t#{@omo_report}\t#{@omo_label}')
  return "$found"
}

# Puts the session's most urgent state in its tab marker and reports it, with its
# message, to the Herdr clients showing the session when it changed; in tab mode each
# tab gets its own window's (report_tabs). Any session of a tab stands for its base.
show_most_urgent() {
  local session body last pid tty term herdr=() old_label rows relabel="" sets=() marker old_marker old_panes old_herdr name tabs=0
  local best best_msg label omo_panes
  session=$(base_session "$1")
  [[ -n $session ]] || return 0
  # One listing for all of it; most_urgent_pane's choice is made from it too.
  rows=$(tmux list-panes -s -t "$session" -F "$pane_rows_format")
  summarize "$rows" 1
  # The session's options are read in one call, and only those that changed are written, in one
  # call at the end: this runs on every state change, pane exit and list pass, and with a dozen
  # clients attached a tmux call that sets options can hold the server for 0.4 s.
  body=$(report_body "$best" "$best_msg" "$label")
  marker=$(icon "$best")
  IFS=$'\x1f' read -r last old_label old_marker old_panes old_herdr name < <(tmux display-message -p -t "$session" \
    $'#{@omo_report}\x1f#{@omo_label}\x1f#{@omo_status}\x1f#{@omo_panes}\x1f#{@omo_herdr}\x1f#{session_name}')
  if [[ $marker != "$old_marker" ]]; then
    if [[ -n $marker ]]; then sets+=(';' set-option -t "$session" @omo_status "$marker"); else sets+=(';' set-option -u -t "$session" @omo_status); fi
  fi
  while read -r pid tty; do
    term=$(herdr_terminal "$pid")
    [[ -n $term ]] || continue
    herdr+=("$term")
    [[ $body == "$last" ]] || send_report "$tty" "$body"
  done < <(tmux list-clients -t "$session" -F '#{client_pid} #{client_tty}')
  [[ $body == "$last" ]] || sets+=(';' set-option -t "$session" @omo_report "$body")
  # The panes counted, so refresh can tell when one has gone.
  [[ $omo_panes == "$old_panes" ]] || sets+=(';' set-option -t "$session" @omo_panes "$omo_panes")
  report_tabs "$session" "$name" "$rows" && tabs=1
  if ((${#herdr[@]} || tabs)); then
    [[ $old_herdr == 1 ]] || sets+=(';' set-option -t "$session" @omo_herdr 1)
  elif [[ -n $old_herdr ]]; then
    sets+=(';' set-option -u -t "$session" @omo_herdr)
  fi
  if ((${#herdr[@]})); then
    if [[ -n $label && $label != "$old_label" ]]; then
      sets+=(';' set-option -t "$session" @omo_label "$label")
      relabel=1
    elif [[ -z $label && -n $old_label ]]; then
      # No omo left in the session: the tab gets its own name (its number) back.
      sets+=(';' set-option -u -t "$session" @omo_label)
      relabel=1
    fi
  fi
  if ((${#sets[@]})); then tmux "${sets[@]:1}"; fi
  if [[ -n $relabel ]]; then label_tabs "$label" "$old_label" "${herdr[@]}" & fi
}

# The pane in a session that most needs you, by the rank its tab shows: a failure,
# a question, then a finished turn, the longest waiting first. Nothing when none does.
most_urgent_pane() {
  tmux list-panes -s -t "$1" -F $'#{pane_id}\t#{@omo_state}\t#{@omo_since}\t#{pane_current_command}' | awk -F'\t' '
    $4 ~ /^-?(zsh|bash|fish|sh|dash)$/ { next }
    $2 == "error" { print 3 "\t" ($3 == "" ? 0 : $3) "\t" $1 }
    $2 == "input" { print 2 "\t" ($3 == "" ? 0 : $3) "\t" $1 }
    $2 == "done" || $2 == "partial" { print 1 "\t" ($3 == "" ? 0 : $3) "\t" $1 }' |
    sort -t$'\t' -k1,1nr -k2,2n | head -n 1 | cut -f3
}

# Goes to the pane that most needs you in a session, else <fallback>, and marks only
# that one seen: the others hold the session's status until you get to them.
visit_session() {
  local session=$1 pane
  pane=$(most_urgent_pane "$session")
  [[ -n $pane ]] || pane=${2:-}
  if [[ -n $pane ]]; then
    # In the session itself: tmux would choose the window's most recently used session, often a tab's.
    tmux select-window -t "$session:$(tmux display-message -p -t "$pane" '#{window_id}')" \; select-pane -t "$pane" 2>/dev/null
    case $(tmux show-option -pqv -t "$pane" @omo_state) in
      input | done | partial | error) tmux set-option -p -t "$pane" @omo_state idle \; set-option -p -u -t "$pane" @omo_msg ;;
    esac
  fi
  show_most_urgent "$session"
}

# Tab mode: a tab shows one window and keeps it, so going to the tab sees that window's panes.
see_window() {
  local session=$1 window=$2 pane state sets=()
  while read -r pane state; do
    case $state in
      input | done | partial | error) sets+=(';' set-option -p -t "$pane" @omo_state idle ';' set-option -p -u -t "$pane" @omo_msg) ;;
    esac
  done < <(tmux list-panes -t "$window" -F '#{pane_id} #{@omo_state}')
  if ((${#sets[@]})); then tmux "${sets[@]:1}"; fi
  show_most_urgent "$session"
}

# Herdr sends tmux no focus events (its clients always read as focused), so going to
# a session there shows up here as a change of Herdr's focused terminal. It counts as
# focusing the tab, unless omo-status moved the focus itself and already chose the pane.
herdr_arrival() {
  local now last shown target window machine=""
  now=$(herdr-app status 2>/dev/null | jq -r '.agent // "none"')
  [[ -n $now ]] || return 0
  last=$(cat "$herdr_focus_file" 2>/dev/null)
  [[ $now == "$last" ]] && return 0
  printf '%s\n' "$now" >"$herdr_focus_file"
  [[ -n $last && $now != none ]] || return 0
  shown=$(cat "$herdr_shown_file" 2>/dev/null)
  (($(date +%s) - ${shown:-0} < 5)) && return 0
  IFS=$'\t' read -r target window < <(herdr_attached "$(herdr-app ls 2>/dev/null)" | awk -F'\t' -v t="$now" '$2 == t { print $1 "\t" $3; exit }')
  [[ -n $target ]] || return 0
  [[ $target == */* ]] && machine=${target%%/*} target=${target#*/}
  at "$machine" arrive "$target" ${window:+"$window"} >/dev/null 2>&1
}

# You are looking at a pane when its tab has focus and its window is showing.
# tmux marks a client in a Herdr terminal focused even while its space is hidden
# (Herdr sends it no focus-out), so only other clients count; for Herdr, its
# focus-in hook (omo-status focus) clears the pane when you go there.
looking_at() {
  local pane=$1 session=$2 pid flags
  [[ $(tmux display-message -p -t "$pane" '#{window_active}') == 1 ]] || return 1
  while read -r pid flags; do
    [[ $flags == *focused* && -z $(herdr_terminal "$pid") ]] && return 0
  done < <(tmux list-clients -t "$session" -F '#{client_pid} #{client_flags}')
  return 1
}

# A tab renamed in Ghostty ignores tmux's title until the override is cleared.
# Finds the tab by its terminal title, which tmux keeps as "[marker ]<session>".
reset_tab_title() {
  # Only the Mac has Ghostty tabs. On a server osascript is missing, and the focus
  # hook's exit 127 made tmux show "... returned 127" over the pane on every switch.
  command -v osascript >/dev/null || return 0
  osascript - "$1" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  set sessionName to item 1 of argv
  if application "Ghostty" is not running then return
  tell application "Ghostty"
    repeat with term in (every terminal whose name is sessionName or name ends with (" " & sessionName))
      perform action "set_tab_title:" on term
    end repeat
  end tell
end run
APPLESCRIPT
}

case ${1:-} in
  set)
    pane=${2:?pane id required} state=${3:?state required}
    # Control characters would end the report early.
    message=$(tr -d '\000-\037\177' <<<"${4:-}")
    # The pane's options are read in one call, and only those that change are written, in one call.
    IFS=$'\x1f' read -r session old_state old_msg task transcript < <(tmux display-message -p -t "$pane" \
      $'#{session_id}\x1f#{@omo_state}\x1f#{@omo_msg}\x1f#{@omo_task}\x1f#{@omo_transcript}' 2>/dev/null)
    [[ -n $session ]] || exit 0
    # A question asked without holding the turn is still open when the turn's Stop comes,
    # so "finished" must not hide it. Answering it, or a new prompt, sets working.
    if [[ $state == "done" && $old_state == input ]]; then
      printf '%s\n' "$old_msg"
      exit 0
    fi
    if [[ $state == "done" ]]; then
      left=$(open_todos "$transcript")
      if [[ -n $left ]]; then state=partial message=$left; fi
    fi
    sets=()
    if [[ $state == working && -n $message ]]; then
      [[ $message == "$task" ]] || sets+=(';' set-option -p -t "$pane" @omo_task "$message")
      task=$message
    fi
    message=$(message_for "$state" "$message" "$task")
    printf '%s\n' "$message"
    if [[ $state != working && $state != background && $state != idle && $state != clear ]] && looking_at "$pane" "$session"; then
      state=idle
    fi
    # When the pane came into its state, for the time Herdr's panel shows.
    [[ $state == "$old_state" || $state == clear ]] || sets+=(';' set-option -p -t "$pane" @omo_since "$(date +%s)")
    case $state in
      clear) forget "$pane" ;;
      idle) [[ $old_state == idle && -z $old_msg ]] || sets+=(';' set-option -p -t "$pane" @omo_state idle ';' set-option -p -u -t "$pane" @omo_msg) ;;
      *) [[ $old_state == "$state" && $old_msg == "$message" ]] || sets+=(';' set-option -p -t "$pane" @omo_state "$state" ';' set-option -p -t "$pane" @omo_msg "$message") ;;
    esac
    if ((${#sets[@]})); then tmux "${sets[@]:1}"; fi
    show_most_urgent "$session"
    touch "$list_tick" 2>/dev/null || { mkdir -p "${list_tick%/*}" && touch "$list_tick"; }
    ;;
  name)
    pane=${2:?pane id required}
    session=$(tmux display-message -p -t "$pane" '#{session_id}' 2>/dev/null) || exit 0
    name=$(tr -d '\000-\037\177' <<<"${3:-}")
    if [[ -n $name ]]; then
      tmux set-option -p -t "$pane" @omo_name "$name"
    else
      tmux set-option -p -u -t "$pane" @omo_name
    fi
    show_most_urgent "$session"
    ;;
  tty)
    target=${2:?tty required} state=${3:?state required}
    message=$(message_for "$state" "$(tr -d '\000-\037\177' <<<"${4:-}")" "")
    printf '%s\n' "$message"
    [[ $state == clear ]] && state=""
    send_report "$target" "$(report_body "$state" "$message")"
    ;;
  focus)
    client=${2:?client required}
    read -r session window base < <(tmux list-clients -F '#{client_name} #{session_id} #{window_id} #{@herdr_base}' |
      awk -v c="$client" '$1 == c { print $2, $3, $4 }')
    [[ -n $session ]] || exit 0
    # A tab mode tab shows one window, which it keeps.
    if [[ -n $base ]]; then
      see_window "$base" "$window"
      exit 0
    fi
    jump=$(tmux show-option -qv -t "$session" @omo_jump)
    [[ -n $jump ]] && tmux set-option -u -t "$session" @omo_jump
    visit_session "$session" "$jump"
    reset_tab_title "$(tmux display-message -p -t "$session" '#{session_name}')"
    ;;
  sync)
    client=${2:?client required}
    read -r session pid tty < <(tmux list-clients -F '#{client_name} #{session_id} #{client_pid} #{client_tty}' |
      awk -v c="$client" '$1 == c { print $2, $3, $4 }')
    [[ -n $session ]] || exit 0
    show_most_urgent "$session"
    # A client that just arrived holds the report of where it was before, or none. An if, not &&: a client
    # outside Herdr (Ghostty) must still exit 0, or tmux prints "... returned 1" in the pane.
    if [[ -n $(herdr_terminal "$pid") ]]; then
      send_report "$tty" "$(tmux show-option -qv -t "$session" @omo_report)"
      # Tab mode: a Herdr tab on the session itself (opened by hand, or `tma`) becomes the tab of its window.
      name=$(tmux display-message -p -t "$session" '#{session_name}')
      if [[ ! $name =~ ~[0-9]+$ ]] && tab_mode "$name"; then tabs_sync "$name"; fi
    fi
    ;;
  refresh)
    # A pane that closes without omo saying so (owt done kills its window, a crash) leaves
    # its session reporting it. Closing a pane only ever lowers a session's state, so a
    # session already reporting nothing is left alone, and so is one whose omo panes are still the
    # ones it counted last (@omo_panes): one listing of sessions and one of panes find the session a
    # pane left, since tmux's pane-exited hook doesn't name it.
    while IFS= read -r session; do
      show_most_urgent "$session"
    done < <({
      tmux list-sessions -f "$real_sessions" -F $'S\x1f#{session_id}\x1f#{@omo_report}\x1f#{@omo_panes}'
      tmux list-panes -a -f "$real_sessions" -F $'P\x1f#{session_id}\x1f#{pane_id}\x1f#{pane_current_command}\x1f#{@omo_state}'
    } | awk -F$'\x1f' '
      $1 == "S" { report[$2] = $3; seen[$2] = $4; order[++n] = $2; next }
      $5 != "" && $4 !~ /^(zsh|bash|fish|sh|dash|-zsh|-bash)$/ { now[$2] = now[$2] $3 "," }
      END { for (i = 1; i <= n; i++) { s = order[i]; if (report[s] != "" && report[s] != "state=clear" && now[s] != seen[s]) print s } }')
    exit 0
    ;;
  arrive)
    session=$(tmux display-message -p -t "=${2:?session required}:" '#{session_id}' 2>/dev/null)
    [[ -n $session ]] || exit 0
    # A tab mode tab (its window given) shows one window, which it keeps.
    if [[ -n ${3:-} ]]; then see_window "$session" "$3"; else visit_session "$session"; fi
    ;;
  list | panes)
    [[ $1 == list ]] && herdr_arrival
    "$0" "$1-here"
    for machine in $(machines); do
      at "$machine" "$1-here" 2>/dev/null | prefixed "$machine"
    done
    ;;
  list-local)
    herdr_arrival
    "$0" list-here
    ;;
  list-remote)
    for machine in $(machines); do
      at "$machine" list-here 2>/dev/null | prefixed "$machine"
    done
    ;;
  jobs-here)
    jobs_here
    ;;
  jobs-remote | jobs)
    [[ $1 == jobs ]] && jobs_here
    # The machine's own omo-status may be older than this one, so the function goes along.
    for machine in $(machines); do
      hc exec --on "$machine" --timeout 8 bash -c "$(declare -f tmux jobs_here all_wakeups; declare -p job_items)"'; jobs_here' jobs 2>/dev/null | prefixed "$machine"
    done
    ;;
  where)
    # Herdr knows a terminal's folder only from its process, and a tmux client's is wherever
    # it was started, so its Files and Changes panels ask this for the pane the client shows.
    terminal=${2:?Herdr terminal required} machine=""
    [[ $terminal == */* ]] && machine=${terminal%%/*}
    info=$(hc get "$terminal" --json 2>/dev/null) && [[ -n $info ]] || exit 1
    pid=$(jq -r '.foreground // {} | select((.argv[0] // "") | test("(^|/)tmux$")) | .pid // empty' <<<"$info")
    [[ -n $pid ]] || exit 0
    if [[ -z $machine ]]; then
      where_here "$pid"
    else
      # The machine's own omo-status may be older than this one, so the function goes along.
      hc exec --on "$machine" --timeout 5 bash -c "$(declare -f tmux where_here)"'; where_here "$1"' where "$pid"
    fi
    ;;
  mcp)
    # Herdr's MCP panel asks for the tmux pane its client shows; on another machine the
    # function goes along, as for where, since that machine's omo-status may be older.
    pane=${2:?tmux pane required} machine=${3:-}
    if [[ -z $machine ]]; then
      mcp_here "$pane"
    else
      hc exec --on "$machine" --timeout 15 bash -c "$(declare -f tmux mcp_here)"'; mcp_here "$1"' mcp "$pane"
    fi
    ;;
  panes-here)
    tmux -u list-panes -a -f "$real_sessions" -F '#{pane_id}|^|#{session_name}|^|#{?session_grouped,#{session_group_attached},#{session_attached}}|^|#{window_index}|^|#{window_name}|^|#{window_active}|^|#{pane_index}|^|#{pane_active}|^|#{pane_current_command}|^|#{pane_current_path}|^|#{@omo_state}|^|#{@omo_msg}'
    ;;
  herdr-sessions)
    herdr_sessions
    ;;
  herdr-save)
    # Kept as it is while Herdr is closed or shows no tmux, so the tabs it brings back after a logout still have
    # their sessions. The first line names the tmux server, so `reattach` can tell it has started again since.
    attached=$(herdr_attached "$(herdr-app ls 2>/dev/null)" 2>/dev/null) && [[ -n $attached ]] || exit 0
    # A tab mode tab's window by its index, which tmux-resurrect brings back (window ids start again).
    attached=$(while IFS=$'\t' read -r key term window; do
      [[ -n $window && $key != */* ]] && window=$(tmux display-message -p -t "$window" '#{window_index}' 2>/dev/null)
      printf '%s\t%s\t%s\n' "$key" "$term" "$window"
    done <<<"$attached")
    mkdir -p "${herdr_tabs_file%/*}"
    printf '#server %s\n%s\n' "$(tmux display-message -p '#{pid}')" "$attached" >"$herdr_tabs_file.$$" &&
      mv "$herdr_tabs_file.$$" "$herdr_tabs_file"
    ;;
  reattach)
    # After a logout or reboot each Herdr tab that showed tmux is left with a shell: herdr-core gives a tab whose
    # program was the tmux client a fresh one, and a tab that ran it from its shell (`tma`) is back at that shell.
    # This puts each back on the tmux session it showed at the last save (herdr-tabs), once that session is back: it
    # starts this Mac's tmux when none runs (omo-sessions boot; tmux-continuum then restores it) and waits up to
    # 90 s. Only shells with nothing running in them, and only sessions no Herdr terminal shows yet. A tab qualifies
    # when this Mac's tmux has started again since that save; when it hasn't (Herdr alone restarted), only a fresh
    # shell from the last <max age> seconds (10 minutes) does, and then a space's first fresh shell with none in
    # herdr-tabs goes on the session the space was made for (the spaces file). omo-sessions resurrect runs it
    # before it reopens omo sessions, and Herdr's tmux-context as Herdr starts. One run at a time.
    max=${2:-600} lock="${spaces_file%/*}/reattach.lock" tries=0
    mkdir -p "${spaces_file%/*}"
    while ! mkdir "$lock" 2>/dev/null && ((tries++ < 1200)); do sleep 0.1; done
    trap 'rmdir "$lock" 2>/dev/null' EXIT
    # Herdr's mods start before it answers.
    for ((tries = 0; tries < 30; tries++)); do
      layout=$(herdr-app ls 2>/dev/null)
      jq -e '.spaces' <<<"$layout" >/dev/null 2>&1 && break
      pgrep -xq Herdr || exit 0
      sleep 1
    done
    jq -e '.spaces' <<<"$layout" >/dev/null 2>&1 || exit 0
    idle=$(idle_shells "$layout" "$max")
    [[ -n $idle ]] || exit 0
    tmux list-sessions >/dev/null 2>&1 || "$HOME/.local/bin/omo-sessions" boot
    server=$(tmux display-message -p '#{pid}' 2>/dev/null)
    saved=$(awk '$1 == "#server" { print $2; exit }' "$herdr_tabs_file" 2>/dev/null)
    plan="" spaced=$'\n'
    while IFS=$'\t' read -r term space fresh; do
      IFS=$'\t' read -r key index < <(awk -F'\t' -v t="$term" '$2 == t { print $1 "\t" $3; exit }' "$herdr_tabs_file" 2>/dev/null)
      if [[ -n $key ]]; then
        # Another machine's tmux didn't start again with this Mac's.
        [[ $fresh == 1 || ($key != */* && -n $saved && $saved != "$server") ]] || continue
      elif [[ $fresh == 1 && $spaced != *$'\n'"$space"$'\n'* ]]; then
        key=$(awk -F'\t' -v s="$space" '$2 == s { print $1; exit }' "$spaces_file" 2>/dev/null)
        [[ -n $key ]] && spaced+="$space"$'\n'
      fi
      [[ -n $key ]] && plan+="$key"$'\t'"$term"$'\t'"$index"$'\n'
    done <<<"$idle"
    deadline=$((SECONDS + 90)) attached=0
    while IFS=$'\t' read -r key term index; do
      [[ -n $key ]] || continue
      machine="" name=$key
      [[ $key == */* ]] && machine=${key%%/*} name=${key#*/}
      until on_machine "$machine" tmux has-session -t "=$name" >/dev/null 2>&1; do
        ((SECONDS < deadline)) || continue 2
        sleep 1
      done
      # Shown already (a tab Herdr kept, or one `spaces` opened): a second client would show it twice.
      # A tab mode tab goes back on the window it showed, in a tab session of its own.
      target=$name tab=""
      if [[ -n $index && -z $machine ]] && tab_mode "$name"; then
        tab=$(tmux display-message -p -t "=$name:$index" '#{window_id}' 2>/dev/null) || continue
        target=$(tab_session "$name" "$(tmux display-message -p -t "=$name:" '#{session_id}')" "$tab") || continue
      fi
      shown=$(herdr_attached "$(herdr-app ls 2>/dev/null)" 2>/dev/null) || continue
      if [[ -n $tab ]]; then
        awk -F'\t' -v k="$key" -v w="$tab" '$1 == k && $3 == w { f = 1 } END { exit !f }' <<<"$shown" && continue
      else
        cut -f1 <<<"$shown" | grep -qxF -- "$key" && continue
      fi
      # In single quotes, as zsh would expand =name to the path of a command called name. Sent as from no terminal:
      # hc wraps a send from another Herdr terminal in <hc> tags, and a tmux server started in one hands every pane
      # its HC_TERMINAL_ID.
      quoted=${target//\'/\'\\\'\'}
      line="exec tmux attach-session -t '=$quoted'"
      [[ -n $tab ]] && line+=" \\; set-option destroy-unattached on"
      env -u HC_TERMINAL_ID -u HC_SCOPE hc send "$term" "$line" >/dev/null 2>&1 || continue
      if [[ -n $tab ]]; then
        tab_terminal "$name" "$tab" 5 >/dev/null && attached=$((attached + 1))
        continue
      fi
      wait_attached "$key"
      if herdr_attached "$(herdr-app ls 2>/dev/null)" 2>/dev/null | cut -f1 | grep -qxF -- "$key"; then
        attached=$((attached + 1))
      else
        echo "omo-status reattach: $term didn't attach to $key" >&2
      fi
    done <<<"$plan"
    # Tab mode sessions: a tab put back on the session itself becomes its window's tab, and windows with none get one.
    while IFS= read -r name; do
      tabs_sync "$name"
    done < <(tab_sessions)
    echo "reattached $attached Herdr tab(s)"
    ;;
  list-here)
    # A turn can end with work still running: a terminal monitor, a background command,
    # a detached eval cell, a child session. omo holds its Stop hook meanwhile, so the
    # pane would stay "working". The transcript's last session-lifecycle entry says what
    # it waits on. It is read only when the transcript grew, the pane's state moved, or
    # its next wake-up changed. A pane with an active goal also has its footer read on
    # every pass, for the time the goal continues.
    jobs=$(scheduled_wakeups)
    now=$(date +%s)
    mkdir -p "$seen_dir"
    while IFS=$'\x1f' read -r pane transcript state old_resume goal old_mins; do
      [[ -r $transcript ]] || continue
      seen=$(cat "$seen_dir/${pane#%}" 2>/dev/null)
      sid=${transcript##*_} sid=${sid%.jsonl} resume="" label="" kind="" left="" mins=""
      [[ -n $jobs ]] && IFS=$'\t' read -r _ resume label < <(grep -F "$sid"$'\t' <<<"$jobs")
      [[ $goal == 1 ]] && read -r kind left < <(goal_wait "$pane")
      if [[ -n $left ]]; then
        mins=$((left / 60))
        # Whole seconds, read a moment apart: within a few of the last reading is the same wake-up.
        at=$((now + left))
        [[ -n $old_resume ]] && ((at - old_resume < 4 && old_resume - at < 4)) && at=$old_resume
        [[ -z $resume ]] || ((at < resume)) && resume=$at
      fi
      size=$(($(wc -c <"$transcript")))
      if [[ "$size $state $resume $goal" != "$seen" ]]; then
        if [[ $resume != "$old_resume" ]]; then
          if [[ -n $resume ]]; then tmux set-option -p -t "$pane" @omo_resume "$resume"; else tmux set-option -p -u -t "$pane" @omo_resume; fi
        fi
        old_goal=$goal goal=0
        grep -Eq '"status": *"active"' "${transcript%/*}/extensions/goal/$sid.json" 2>/dev/null && goal=1
        IFS=$'\x1f' read -r lifecycle work < <(tail -c 300000 "$transcript" | grep '"customType":"session-lifecycle"' | tail -n 1 | jq -r "$background_work" 2>/dev/null)
        if [[ -n $kind ]]; then
          case $work in
            "goal · "*) work="goal $kind · ${work#goal · }" ;;
            "") work="goal $kind" ;;
            *) work="goal $kind · $work" ;;
          esac
        fi
        if [[ -z $lifecycle ]]; then
          : # no entry in the part of the transcript read: leave the pane as it is
        elif [[ $lifecycle != running && -n $work ]]; then
          "$0" set "$pane" background "$work" >/dev/null
        elif [[ $lifecycle != running && -n $resume ]]; then
          "$0" set "$pane" background "Scheduled: $label" >/dev/null
        elif [[ $state == background && $lifecycle == running ]]; then
          "$0" set "$pane" working >/dev/null
        elif [[ $state == background || ($state == working && $lifecycle == waiting_*) ]]; then
          "$0" set "$pane" idle >/dev/null
        fi
        [[ $goal == "$old_goal" ]] || tmux set-option -p -t "$pane" @omo_goal "$goal"
        printf '%s\n' "$size $(tmux show-option -pqv -t "$pane" @omo_state) $resume $goal" >"$seen_dir/${pane#%}"
      fi
      if [[ $mins != "$old_mins" ]]; then
        if [[ -n $mins ]]; then tmux set-option -p -t "$pane" @omo_goal_mins "$mins"; else tmux set-option -p -u -t "$pane" @omo_goal_mins; fi
        show_most_urgent "$(tmux display-message -p -t "$pane" '#{session_id}')"
      fi
    done < <(tmux list-panes -a -f "$real_sessions" -F $'#{pane_id}\x1f#{@omo_transcript}\x1f#{@omo_state}\x1f#{@omo_resume}\x1f#{@omo_goal}\x1f#{@omo_goal_mins}' |
      awk -F$'\x1f' '$2 != "" && ($3 == "working" || $3 == "background" || $3 == "idle")')
    # omo is bun running senpi's CLI (or omo's launcher) on the pane's terminal. A
    # pane omo's hooks haven't reached yet is idle; a pane connected to a server
    # (mosh, ssh) shows the state its title brought. Fields are split by "|^|",
    # because tmux prints control characters as "_" when Herdr runs it.
    # Only the panes' own terminals are searched: ps -A over every process takes ten times as long.
    panes=$(tmux -u list-panes -a -f "$real_sessions" -F '#{pane_tty}|^|#{pane_current_command}|^|#{pane_id}|^|#{session_name}|^|#{window_name}|^|#{pane_current_path}|^|#{@omo_state}|^|#{@omo_since}|^|#{@omo_resume}|^|#{@omo_msg}')
    ttys=() omo_ttys=""
    while IFS= read -r line; do
      line=${line%%"|^|"*}
      [[ -n $line ]] && ttys+=(-t "${line#/dev/}")
    done <<<"$panes"
    ((${#ttys[@]})) && omo_ttys=$(ps -o tty=,args= "${ttys[@]}" 2>/dev/null |
      awk '/\/senpi\/dist\/bundle\/cli\.js|\/omo-ai\/bin\/omo\.js/ { print "/dev/" $1 }' | sort -u)
    OMO_TTYS=$omo_ttys awk '
        function fields(s, f,   n, i) {
          n = 0
          while ((i = index(s, "|^|")) > 0) { f[++n] = substr(s, 1, i - 1); s = substr(s, i + 3) }
          f[++n] = s
          return n
        }
        BEGIN { n = split(ENVIRON["OMO_TTYS"], t, "\n"); for (i = 1; i <= n; i++) omo[t[i]] = 1 }
        {
          n = fields($0, f)
          state = f[7]
          if (f[1] in omo) { if (state == "") state = "idle" }
          else if (!((f[2] == "mosh-client" || f[2] == "ssh") && state != "")) next
          msg = f[10]
          for (i = 11; i <= n; i++) msg = msg "|^|" f[i]
          print f[3] "|^|" f[4] "|^|" f[5] "|^|" f[6] "|^|" state "|^|" f[8] "|^|" f[9] "|^|" msg
        }' <<<"$panes"
    ;;
  locate)
    # Selects the pane and prints "<Herdr terminal on its session>\x1f<session>\x1f<folder>\x1f<tab>", the terminal
    # empty when no Herdr terminal shows the session. In tab mode the terminal is the tab on the pane's window, and
    # <tab> that window's id.
    pane=${2:?pane id required} exact=${3:-} terminal="" tab=""
    session=$(base_session "$pane")
    [[ -n $session ]] || exit 1
    # A click on a pane that needs nothing goes to the one in its session that does,
    # unless it asked for exactly that pane (a row in Herdr's Agents tree).
    case $exact:$(tmux show-option -pqv -t "$pane" @omo_state) in
      exact:* | *:input | *:done | *:partial | *:error) ;;
      *)
        urgent=$(most_urgent_pane "$session")
        [[ -n $urgent ]] && pane=$urgent
        ;;
    esac
    window=$(tmux display-message -p -t "$pane" '#{window_id}')
    tmux select-window -t "$session:$window" \; select-pane -t "$pane"
    # Going to a pane is looking at it. A Herdr client gets no focus-in hook for it
    # (tmux already counts it focused), so a finished or waiting pane clears here.
    case $(tmux show-option -pqv -t "$pane" @omo_state) in
      input | done | partial | error) "$0" set "$pane" idle >/dev/null ;;
    esac
    name=$(tmux display-message -p -t "$session" '#{session_name}')
    if tab_mode "$name"; then
      tab=$window
      terminal=$(tab_terminal "$name" "$window")
    else
      while read -r pid client_session; do
        [[ $client_session == "$session" ]] || continue
        terminal=$(herdr_terminal "$pid")
        [[ -n $terminal ]] && break
      done < <(tmux list-clients -F '#{client_pid} #{session_id}')
    fi
    printf '%s\x1f%s\x1f%s\x1f%s\n' "$terminal" "$name" "$(tmux display-message -p -t "$pane" '#{pane_current_path}')" "$tab"
    ;;
  show)
    pane=${2:?pane id required} exact=${3:-} machine=""
    [[ $pane == */* ]] && machine=${pane%%/*} pane=${pane#*/}
    date +%s >"$herdr_shown_file"
    # exact goes last, so another machine's older omo-status ignores it.
    IFS=$'\x1f' read -r terminal session folder tab < <(at "$machine" locate "$pane" ${exact:+"$exact"}) || exit 1
    if [[ -n $terminal ]]; then
      herdr-app "do" pane.focus --terminal "${machine:+$machine/}$terminal" >/dev/null
    elif [[ -n $tab ]]; then
      # Tab mode: the window's tab opens, even one you closed.
      tabs_sync "${machine:+$machine/}$session" "" "$tab"
    else
      open_space "$session" "$folder" "$pane" "$machine"
    fi
    date +%s >"$herdr_shown_file"
    ;;
  open)
    target=${2:?tmux target required} host=${3:-} machine=""
    if [[ -n $host ]] && command -v hc >/dev/null; then
      machine=$(hc machine ls --json 2>/dev/null |
        jq -r --arg h "$host" 'first(.machines[] | select(.host == $h and .state == "connected") | .name) // empty')
    fi
    "$0" show "${machine:+$machine/}$target" || exit 1
    open -a Herdr 2>/dev/null
    ;;
  sessions)
    sessions_here
    # A machine's own omo-status may be older than this one, so the functions go along, as for jobs.
    for machine in $(machines); do
      hc exec --on "$machine" --timeout 5 bash -c "$(declare -f tmux herdr_terminal herdr_sessions sessions_here)"'; sessions_here' sessions 2>/dev/null |
        sed "s|^|$machine/|"
    done
    ;;
  tints)
    tints_here
    for machine in $(machines); do
      hc exec --on "$machine" --timeout 5 bash -c "$(declare -f tmux tints_here)"'; tints_here' tints 2>/dev/null |
        sed "s|^|$machine/|"
    done
    ;;
  session)
    # Herdr's search (Cmd+P) runs this for a name that matches no session. tmux turns "." and ":"
    # in a name into "_", and the scripts here split on spaces, so only these characters pass.
    name=${2:?session name required} machine=${3:-}
    [[ $name =~ ^[A-Za-z0-9_-]+$ ]] || { echo "omo-status session: use letters, digits, - and _ in a session name" >&2; exit 2; }
    start='tmux has-session -t "=$1" 2>/dev/null || tmux new-session -d -s "$1" -c "$HOME" || exit 1
      tmux display-message -p -t "=$1:" "#{session_path}"'
    if [[ -z $machine ]]; then
      folder=$(sh -c "$start" _ "$name") || exit 1
      [[ -n $folder ]] || exit 1
      open_space "$name" "$folder" "=$name"
    elif folder=$(hc exec --on "$machine" --timeout 8 tmux display-message -p -t "=$name:" '#{session_path}' 2>/dev/null) &&
      [[ -n $folder ]]; then
      open_space "$name" "$folder" "=$name" "$machine"
    else
      # A tmux server hc exec starts ends with the call, and the session with it, so a session the machine doesn't have
      # yet is made by the Herdr terminal that shows it: `tmux new-session -A` there starts tmux too when none runs.
      folder=$(hc exec --on "$machine" --timeout 8 sh -c 'printf %s "$HOME"') && [[ -n $folder ]] || exit 1
      open_space "$name" "$folder" "=$name" "$machine" \
        "$(jq -cn --arg n "$name" --arg d "$folder" '["tmux", "new-session", "-A", "-s", $n, "-c", $d]')"
    fi
    ;;
  tabs)
    # Each machine keeps its own list of sessions in tab mode, where its tmux runs and its hooks read it.
    target=${2:?session or --all required} mode=${3:-}
    case $mode in "" | on | off) ;; *) echo "omo-status tabs: on or off" >&2; exit 2 ;; esac
    if [[ $target == --all ]]; then
      if [[ -z $mode ]]; then
        if grep -qxF '*' "$tab_sessions_file" 2>/dev/null; then echo on; else echo off; fi
        exit 0
      fi
      for machine in "" $(machines); do
        if [[ $mode == on ]]; then
          tabs_at "$machine" tab_mode_set --all on
        else
          shown=$(tabs_at "$machine" tab_sessions)
          tabs_at "$machine" tab_mode_set --all off
          for name in $shown; do tabs_off "${machine:+$machine/}$name"; done
        fi
      done
      # Each session Herdr shows gets its tabs now, the others when Herdr shows them.
      if [[ $mode == on ]]; then
        for key in $({ herdr_attached "$(herdr-app ls 2>/dev/null)" 2>/dev/null | cut -f1; herdr_sessions; } | sort -u); do
          tabs_sync "$key" --all
        done
      fi
      exit 0
    fi
    machine="" name=$target
    [[ $target == */* ]] && machine=${target%%/*} name=${target#*/}
    tabs_at "$machine" tmux has-session -t "=$name" 2>/dev/null || { echo "omo-status tabs: no tmux session $target" >&2; exit 1; }
    case $mode in
      "") if tabs_at "$machine" tab_mode "$name"; then echo on; else echo off; fi ;;
      on)
        tabs_at "$machine" tab_mode_set "$name" on
        tabs_sync "$target" --all
        ;;
      off)
        tabs_at "$machine" tab_mode "$name" || exit 0
        tabs_at "$machine" tab_mode_set "$name" off
        tabs_off "$target"
        ;;
    esac
    ;;
  tabs-sync)
    # tmux's hooks: a window was made, or a tab's session showed another window. A tab's session stands for its own.
    name=${2:?session required}
    [[ $name =~ ~[0-9]+$ ]] && name=${name%~*}
    tab_mode "$name" || exit 0
    tabs_sync "$name"
    ;;
  tabs-pending)
    # The follow agent: Herdr machine <machine>'s tab mode hooks noted these sessions (tabs_request).
    machine=${2:?machine required}
    for name in $(hc exec --on "$machine" --timeout 5 sh -c 'd="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/tabs"
      [ -f "$d/pending" ] || exit 0
      mv "$d/pending" "$d/pending.$$" && sort -u "$d/pending.$$" && rm -f "$d/pending.$$"'); do
      tabs_sync "$machine/$name"
    done
    ;;
  ack)
    pane=${2:?pane id required} machine=""
    [[ $pane == */* ]] && machine=${pane%%/*} pane=${pane#*/}
    at "$machine" set "$pane" idle >/dev/null
    if [[ -n $machine ]]; then
      mkdir -p "$remote_dir" && touch "$remote_dir/seen"
    fi
    ;;
  follow)
    # One follow_machine per connected Herdr machine, started again if it ends; the machines are
    # looked at every 30 s, so one connected later is followed too.
    mkdir -p "$remote_dir"
    running=""
    while :; do
      for machine in $(machines); do
        pid=$(awk -v m="$machine" '$1 == m { print $2 }' <<<"$running")
        [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && continue
        follow_machine "$machine" &
        running="$(awk -v m="$machine" '$1 != m' <<<"$running")"$'\n'"$machine $!"
      done
      sleep 30
    done
    ;;
  install)
    [[ $(uname) == Darwin ]] || { echo "omo-status install: the agent is a launchd agent, for a Mac" >&2; exit 1; }
    label=local.omo-status-follow
    plist="$HOME/Library/LaunchAgents/$label.plist"
    log="${XDG_STATE_HOME:-$HOME/.local/state}/omo-status/follow.log"
    mkdir -p "${log%/*}" "${plist%/*}"
    # launchd's own PATH would start this script with macOS's bash 3.2.
    cat >"$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$HOME/.local/bin/omo-status</string>
    <string>follow</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>$log</string>
  <key>StandardErrorPath</key>
  <string>$log</string>
</dict>
</plist>
PLIST
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null
    launchctl bootstrap "gui/$(id -u)" "$plist" && echo "omo-status: following the other machines' omo state ($plist)"
    ;;
  next)
    pane=$("$0" list | awk -F'[|][\\^][|]' '
      $5 == "input" || $5 == "error" { r = 2 } $5 == "done" || $5 == "partial" { r = 1 } $5 != "input" && $5 != "error" && $5 != "done" && $5 != "partial" { next }
      { print r "\t" ($6 == "" ? 0 : $6) "\t" $1 }' | sort -t$'\t' -k1,1nr -k2,2n | head -n 1 | cut -f3)
    [[ -n $pane ]] || { echo "nothing needs you" >&2; exit 1; }
    exec "$0" show "$pane"
    ;;
  spaces)
    # One sync at a time: tmux and omo hooks can start several together.
    lock="${spaces_file%/*}/spaces.lock"
    mkdir -p "${spaces_file%/*}"
    mkdir "$lock" 2>/dev/null || exit 0
    trap 'rmdir "$lock"' EXIT
    here=$(herdr-app status 2>/dev/null | jq -r '.space // empty')
    connected=$(machines)
    # What Herdr already shows, from its own terminals and from the tmux clients in
    # them. If that can't be read, stop: a wrong "nothing is shown" opens every session.
    layout=$(herdr-app ls 2>/dev/null)
    if ! attached=$(herdr_attached "$layout"); then
      echo "omo-status spaces: couldn't read Herdr's terminals, so nothing was opened" >&2
      exit 0
    fi
    shown=$'\n'"$(cut -f1 <<<"$attached")"$'\n'"$(herdr_sessions)"$'\n'
    # --local (omo's start hook, tmux's session-closed hook): a server's session
    # gets a Herdr client, which resizes it under your mosh client, only on request.
    rows=list
    if [[ ${2:-} == --local ]]; then
      rows=list-here
    else
      for machine in $connected; do
        shown+="$(at "$machine" herdr-sessions 2>/dev/null | sed "s|^|$machine/|")"$'\n'
      done
    fi
    # A machine's saved spaces still have tabs, yet nothing was found attached there: the same failure. --local
    # reads only this computer's clients, so only this computer is checked: a server's space with a tab but no tmux
    # client used to stop every --local run, and with it the closing of spaces for sessions that ended.
    checked=$connected
    [[ $rows == list-here ]] && checked=""
    for machine in "" $checked; do
      attached_here='^[^/]+$'
      [[ -n $machine ]] && attached_here="^$machine/"
      if ! grep -Eq "$attached_here" <<<"$shown" && [[ -f $spaces_file ]] &&
        cut -f2 "$spaces_file" | grep -Fxq -f <(jq -r --arg m "$machine" '.spaces[] | select((.machine // "") == $m and (.tabs | length) > 0) | .id' <<<"$layout"); then
        echo "omo-status spaces: found no attached terminal in spaces that have tabs, so nothing was opened" >&2
        exit 0
      fi
    done
    opened=0 closed=0
    while IFS= read -r line; do
      pane=${line%%"|^|"*} rest=${line#*"|^|"}
      session=${rest%%"|^|"*} rest=${rest#*"|^|"}
      rest=${rest#*"|^|"} folder=${rest%%"|^|"*}
      [[ $shown == *$'\n'"$session"$'\n'* ]] && continue
      shown+="$session"$'\n'
      machine=""
      [[ $pane == */* ]] && machine=${pane%%/*} pane=${pane#*/} session=${session#*/}
      open_space "$session" "$folder" "$pane" "$machine" && opened=$((opened + 1))
    done < <("$0" "$rows")
    # Tab mode sessions: a tab for each new window, and the rest of tabs_sync's care. --local: this computer's only.
    while IFS= read -r name; do
      tabs_sync "$name"
    done < <(tab_sessions)
    if [[ $rows == list ]]; then
      for machine in $connected; do
        for name in $(tabs_at "$machine" tab_sessions 2>/dev/null); do
          tabs_sync "$machine/$name"
        done
      done
    fi
    if [[ -f $spaces_file ]]; then
      kept="" open=$'\n'$(herdr-app ls 2>/dev/null | jq -r '.spaces[].id')$'\n'
      while IFS=$'\t' read -r session space; do
        machine="" name=$session alive=1
        [[ $session == */* ]] && machine=${session%%/*} name=${session#*/}
        if [[ -z $machine ]]; then
          tmux has-session -t "=$name" 2>/dev/null || alive=""
        elif [[ $'\n'$connected$'\n' == *$'\n'"$machine"$'\n'* ]]; then
          hc exec --on "$machine" --timeout 5 tmux has-session -t "=$name" >/dev/null 2>&1 || alive=""
        fi # a machine that is away keeps its spaces: its sessions may well live on
        if [[ -z $alive ]]; then
          herdr-app "do" space.close --id "$space" --confirmed true >/dev/null 2>&1 && closed=$((closed + 1))
          continue
        fi
        # One line per session, for a space that is still open. An away machine's lines stay.
        [[ $'\n'$kept == *$'\n'"$session"$'\t'* ]] && continue
        if [[ -z ${open//$'\n'/} || $open == *$'\n'"$space"$'\n'* ||
          (-n $machine && $'\n'$connected$'\n' != *$'\n'"$machine"$'\n'*) ]]; then
          kept+="$session"$'\t'"$space"$'\n'
        fi
      done <"$spaces_file"
      printf '%s' "$kept" >"$spaces_file"
    fi
    [[ -n $here ]] && herdr-app "do" space.select --id "$here" >/dev/null
    echo "opened $opened space(s), closed $closed"
    ;;
  *)
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
    exit 2
    ;;
esac
